speed 1000
connect
mem32 0xE000EDF0 1
mem32 0xE000ED08 1
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\out\flash\2026-10-20-b-brake-install-180251\ram-final.bin", 0x20000000, 0x10000
qc
