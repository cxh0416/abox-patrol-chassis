savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\docs\operations\evidence\2026-10-20-b-brake-install-180251\tick-last.bin", 0x2000021C, 0x4
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\docs\operations\evidence\2026-10-20-b-brake-install-180251\app-readback.bin", 0x08008000, 0x24E10
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\out\flash\2026-10-20-b-brake-install-180251\config-running.bin", 0x0803F800, 0x800
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\docs\operations\evidence\2026-10-20-b-brake-install-180251\boot-state-running.bin", 0x0803E800, 0x1000
