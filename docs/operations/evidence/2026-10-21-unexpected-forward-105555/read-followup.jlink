mem32 0x2000021C 1
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\out\flash\2026-10-21-unexpected-forward-105555/ram-followup.bin", 0x20000000, 0x10000
mem32 0x2000021C 1
qc
