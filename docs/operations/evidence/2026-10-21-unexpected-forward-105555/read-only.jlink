device STM32F105RC
exec InhibitConnectRetries = 1
exec ForceAttachTarget = 1
if SWD
speed 1000
connect
mem32 0xE000EDF0 1
mem32 0xE000ED00 20
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\out\flash\2026-10-21-unexpected-forward-105555/flash-readonly.bin", 0x08000000, 0x40000
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\out\flash\2026-10-21-unexpected-forward-105555/ram-first.bin", 0x20000000, 0x10000
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\docs\operations\evidence\2026-10-21-unexpected-forward-105555/uid.bin", 0x1FFFF7E8, 0xC
mem32 0x40006400 8
mem32 0x40006800 8
mem32 0xE000EDF0 1
savebin "E:\1_work\ChassisCar\abox-patrol-vehicle-chassis-firmware\out\flash\2026-10-21-unexpected-forward-105555/ram-last.bin", 0x20000000, 0x10000
qc
