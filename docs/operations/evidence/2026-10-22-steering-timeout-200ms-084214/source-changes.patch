@@ -214,11 +214,22 @@ int main(void)
     BenchSteering_OnFrame(&b,&r,11); assert(b.pending);
     r=reply(&b,-111593); r.data[1]++;
     assert(!BenchSteering_OnFrame(&b,&r,12)&&b.pending);
