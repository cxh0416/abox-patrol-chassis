+            BenchSteering_Tick(&b,1081,1,1,0,0);
+            assert(b.phase==BENCH_FAULT&&b.cut_power);
+        }
         else assert(b.phase==BENCH_ACTIVE&&!b.pending&&!b.fault);
     }
     BenchSteering_Init(&b); BenchSteering_Start(&b,-83815,-85123,-85123,1000,0); now=0;
