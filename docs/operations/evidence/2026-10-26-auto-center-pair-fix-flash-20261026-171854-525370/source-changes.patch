+    feedback.power_ready = feedback.encoder_profile_ready = feedback.encoder_range_valid = 1U;
+    feedback.feedback_ms = 100U;
+    feedback.angle_pair_valid = 1U;
+    ChassisControl_SetFeedback(&control, &feedback);
+    CHECK(ChassisControl_Apply(&control, "acquire", "aligned", 1U, 300U, 0, 0, 100U));
+
+    /* Time-aligned disagreement is a real angle fault and preserves its reason. */
+    feedback.steering_actual_mdeg = 3000;
+    feedback.encoder_actual_mdeg = 0;
+    feedback.feedback_ms = 130U;
+    ChassisControl_SetFeedback(&control, &feedback);
+    ChassisControl_Tick(&control, 130U);
+    CHECK(control.fault_latched && control.stop_reason == CHASSIS_STOP_ANGLE_MISMATCH);
+
+    /* Timestamp skew only inhibits new motion; it must not be reported as a
+     * measured 2-degree mismatch before aligned samples are available. */
+    ChassisControl_Init(&control);
+    feedback.angle_pair_valid = 0U;
+    feedback.steering_actual_mdeg = 3000;
+    feedback.encoder_actual_mdeg = 0;
+    feedback.feedback_ms = 240U;
+    ChassisControl_SetFeedback(&control, &feedback);
+    /* Pair skew must not become a whole-chassis emergency gate: transient
+     * source scheduling may make one snapshot unusable while both channels
+     * remain individually healthy. New motion is rejected below instead. */
+    CHECK(ChassisControl_SafetyReason(&control, 240U) == CHASSIS_STOP_NONE);
+    CHECK(ChassisControl_SafetyReady(&control, 240U));
+    CHECK(!ChassisControl_Apply(&control, "acquire", "skewed", 1U, 300U, 0, 0, 240U));
+    CHECK(!control.fault_latched && control.stop_reason == CHASSIS_STOP_FEEDBACK_STALE);
     return 0;
 }
 
