\n    {\n        VehiclePowerPort_Poll(HAL_GetTick());\n        taskENTER_CRITICAL();\n        RemoteService_SafetyTick(HAL_GetTick());\n        PatrolCanRemote_Tick(HAL_GetTick(),\n            (uint8_t)((hcan2.Instance->ESR & CAN_ESR_BOFF) == 0U));\n        /* >>>>> PHY-REMOTE: START >>>>> */\n        PatrolPhyRemote_Tick(HAL_GetTick(),\n            (uint8_t)((hcan2.Instance->ESR & CAN_ESR_BOFF) == 0U));\n        /* <<<<< PHY-REMOTE: END <<<<< */\n        taskEXIT_CRITICAL();\n        xEventGroupSetBits(g_health_events, PATROL_HEALTH_SAFETY);\n        vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(10U));\n    }\n}\n\n/* >>>>> CAN2-GATEWAY: START >>>>> */\n#if PATROL_CHASSIS_CAN2_GATEWAY_ENABLED\n// 在网关编译开关允许时转发受约束的 CAN 帧。保留总线来源和既有过滤规则，网关不代替产品会话及运动许可仲裁。\nstatic void patrol_can_gateway_forward(const PatrolCanFrame_t *frame)\n{\n    /* Offline remote: transparently bridge CAN2 (remote port) and CAN1\n     * (chassis CANopen). Standard data frames are relayed verbatim so a PC\n     * CANopen master on CAN2 can command the Node 1 steering and Node 2 dual\n     * drive on CAN1. Extended/remote frames are not forwarded. */\n    CAN_TxHeaderTypeDef header = {0};\n    CAN_HandleTypeDef *target;\n    uint32_t mailbox;\n    if (frame == 0 || frame->header.IDE != CAN_ID_STD || frame->header.RTR != CAN_RTR_DATA)\n        return;\n    target = (frame->bus == 1U) ? &hcan1 : &hcan2;\n    header.StdId = frame->header.StdId;\n    header.IDE = CAN_ID_STD;\n    header.RTR = CAN_RTR_DATA;\n    header.DLC = frame->header.DLC;\n    header.TransmitGlobalTime = DISABLE;\n    (void)HAL_CAN_AddTxMessage(target, &header, (uint8_t *)frame->data, &mailbox);\n}\n#endif\n/* <<<<< CAN2-GATEWAY: END <<<<< */\n\n// 消费 CAN 接收队列并按来源分发协议。分离遥控入口、驱动器反馈与可选网关，运动共享状态按临界区约定更新。\nstatic void Patrol_CanRxTask(void *argument)\n{\n    PatrolCanFrame_t frame;\n    PatrolCanFrame decoded;\n    PatrolCanFrame replies[3];\n    uint8_t replies_ready = 0U;\n    uint8_t reply_index = 0U;\n    TickType_t reply_started = 0U;\n    (void)argument;\n    patrol_start_can();\n    for (;;)\n    {\n        const TickType_t wait_ticks = replies_ready ?\n            pdMS_TO_TICKS(PATROL_CAN_REPLY_RETRY_MS) : pdMS_TO_TICKS(100U);\n        (void)ulTaskNotifyTake(pdTRUE, wait_ticks);\n        while (PatrolRtos_CanRxPop(&frame, 0U) == pdPASS)\n        {\n/* >>>>> CAN2-GATEWAY: START >>>>> */\n#if PATROL_CHASSIS_CAN2_GATEWAY_ENABLED\n            patrol_can_gateway_forward(&frame);\n#endif\n/* <<<<< CAN2-GATEWAY: END <<<<< */\n            if (frame.header.IDE != CAN_ID_STD || frame.header.RTR != CAN_RTR_DATA ||\n                frame.header.DLC > 8U)\n                continue;\n            memset(&decoded, 0, sizeof(decoded));\n            decoded.id = (uint16_t)frame.header.StdId;\n            decoded.dlc = (uint8_t)frame.header.DLC;\n            memcpy(decoded.data, frame.data, sizeof(decoded.data));\n            taskENTER_CRITICAL();\n            if (frame.bus == 1U) {\n                /* >>>>> PHY-REMOTE: START >>>>> */\n                /* Handset receiver (0x10A/0x10B) is wired to CAN2; check it\n                 * before the CAN2 keyboard command service (0x520). */\n                if (!PatrolPhyRemote_OnFrame(&decoded, frame.timestamp_ms, HAL_GetTick())) {\n                    PatrolCanRemote_OnFrame(&decoded, frame.timestamp_ms, HAL_GetTick());\n                }\n                /* <<<<< PHY-REMOTE: END <<<<< */\n            } else {\n                PatrolRuntime_OnCanFrame(&decoded, frame.timestamp_ms);\n            }\n            taskEXIT_CRITICAL();\n        }\n        if (!replies_ready) {\n            taskENTER_CRITICAL();\n            replies_ready = PatrolCanRemote_TakeReply(replies, HAL_GetTick());\n            taskEXIT_CRITICAL();\n            reply_index = 0U;\n            reply_started = xTaskGetTickCount();\n        }\n        if (replies_ready) {\n            CAN_TxHeaderTypeDef header = {0};\n            uint32_t mailbox;\n            header.StdId = replies[reply_index].id;\n            header.IDE = CAN_ID_STD;\n            header.RTR = CAN_RTR_DATA;\n            header.DLC = replies[reply_index].dlc;\n            if (HAL_CAN_AddTxMessage(&hcan2, &header, replies[reply_index].data,\n                                     &mailbox) == HAL_OK) {\n                reply_index++;\n                if (reply_index >= 3U) replies_ready = 0U;\n            } else if ((TickType_t)(xTaskGetTickCount() - reply_started) >=\n                       pdMS_TO_TICKS(PATROL_CAN_REPLY_TIMEOUT_MS)) {\n                /* A temporary full mailbox must not discard the remaining\n                 * correlated frames. Only a persistent transport failure\n                 * invalidates the CAN2 remote session. */\n                replies_ready = 0U;\n                taskENTER_CRITICAL();\n                PatrolCanRemote_Tick(HAL_GetTick(), 0U);\n                taskEXIT_CRITICAL();\n            }\n        }\n        xEventGroupSetBits(g_health_events, PATROL_HEALTH_CAN_RX);\n    }\n}\n\n// 串行推进运动运行层和 CANopen 执行事务。按固定周期调用 Tick，发送前重新检查授权；不以 CAN 提交成功当作真实运动或停车完成。\nstatic void Patrol_CanopenTask(void *argument)\n{\n    TickType_t last_wake = xTaskGetTickCount();\n    (void)argument;\n    for (;;) {\n#if PATROL_CHASSIS_READONLY_DIAGNOSTICS_ENABLED\n        PatrolRuntime_Tick();\n#endif\n        xEventGroupSetBits(g_health_events, PATROL_HEALTH_CANOPEN);\n        vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(10U));\n    }\n}\n\n// 执行绝对编码器串口读取、标定写入及复读验证。单一任务拥有 UART 事务，只有有效响应更新反馈时间，结果通过运行层受保护接口发布。\nstatic void Patrol_EncoderTask(void *argument)\n{\n    (void)argument;\n    for (;;)\n    {\n#if PATROL_CHASSIS_READONLY_DIAGNOSTICS_ENABLED\n        uint8_t request[ABS_ENCODER_REQUEST_SIZE];\n        uint8_t response[ABS_ENCODER_RX_BUFFER_SIZE] = {0};\n        uint16_t registers[3];\n        uint16_t response_length = 0U;\n        uint16_t register_count;\n        uint8_t read_config;\n        uint8_t response_ok = 0U;\n        HAL_StatusTypeDef status;\n        PatrolDiagnosticsSnapshot snapshot;\n        uint32_t now;\n        uint8_t write_center = 0U;\n        taskENTER_CRITICAL();\n        now = HAL_GetTick();\n        write_center = PatrolRuntime_BeginEncoderCycle(&snapshot);\n        taskEXIT_CRITICAL();\n        if (write_center) {\n            AbsoluteEncoder_BuildWriteSingleRequest(3U, VEHICLE_ABSOLUTE_ZERO_COMMAND, request);\n            (void)HAL_UART_AbortReceive(&huart5);\n            __HAL_UART_FLUSH_DRREGISTER(&huart5);\n            status = HAL_UART_Transmit(&huart5, request, sizeof(request), 30U);\n            if (status == HAL_OK) {\n                HAL_StatusTypeDef receive_status = HAL_UARTEx_ReceiveToIdle(\n                    &huart5, response, sizeof(response), &response_length, 40U);\n                taskENTER_CRITICAL();\n                PatrolRuntime_EncoderWriteCompleted((receive_status == HAL_OK &&\n                    AbsoluteEncoder_ParseWriteSingleResponse(response, response_length, 3U,\n                        VEHICLE_ABSOLUTE_ZERO_COMMAND)) ? 2U : 5U);\n                taskEXIT_CRITICAL();\n            } else {\n                taskENTER_CRITICAL();\n                PatrolRuntime_EncoderWriteCompleted(3U);\n                taskEXIT_CRITICAL();\n            }\n            vTaskDelay(pdMS_TO_TICKS(20U));\n            continue;\n        }\n        read_config = (uint8_t)(!snapshot.encoder_config_valid);\n        register_count = read_config ? 3U : 2U;\n        AbsoluteEncoder_BuildReadHoldingRequest(read_config ? 0U : 3U, register_count, request);\n        (void)HAL_UART_AbortReceive(&huart5);\n        __HAL_UART_FLUSH_DRREGISTER(&huart5);\n        status = HAL_UART_Transmit(&huart5, request, sizeof(request), 30U);\n        if (status == HAL_OK) {\n            /* A half-duplex adapter may deliver the request echo and the\n             * encoder reply as separate idle-delimited chunks. Collect at\n             * most two chunks, then search the combined buffer for a valid\n             * Modbus response. */\n            for (uint8_t chunk = 0U; chunk < 2U && response_length < sizeof(response); chunk++) {\n                uint16_t received = 0U;\n                status = HAL_UARTEx_ReceiveToIdle(\n                    &huart5, response + response_length,\n                    (uint16_t)(sizeof(response) - response_length), &received, 40U);\n                response_length += received;\n                if (status == HAL_OK && AbsoluteEncoder_ParseHoldingResponseAnywhere(\n                        response, response_length, registers, register_count)) {\n                    response_ok = 1U;\n                    break;\n                }\n                if (received == 0U) break;\n            }\n        }\n        taskENTER_CRITICAL();\n        if (response_ok)\n        {\n            if (read_config)\n                PatrolRuntime_OnEncoderConfig(registers, now);\n            else\n                PatrolRuntime_OnEncoderCount(\n                    (uint32_t)registers[0] | (uint32_t)registers[1] << 16, now);\n        }\n        else if (response_length >= 2U && response[0] == ABS_ENCODER_ADDRESS &&\n                 response[1] == (uint8_t)(0x03U | 0x80U))\n            PatrolRuntime_OnEncoderError(PATROL_ENCODER_ERROR_EXCEPTION);\n        else if (status == HAL_TIMEOUT || response_length == 0U)\n            PatrolRuntime_OnEncoderError(PATROL_ENCODER_ERROR_TIMEOUT);\n        else if (response_length >= 5U && AbsoluteEncoder_Crc16(response,\n                 (uint16_t)(response_length - 2U)) != ((uint16_t)response[response_length - 2U] |\n                 (uint16_t)response[response_length - 1U] << 8))\n            PatrolRuntime_OnEncoderError(PATROL_ENCODER_ERROR_CRC);\n        else if (status != HAL_OK)\n            PatrolRuntime_OnEncoderError(PATROL_ENCODER_ERROR_TRANSPORT);\n        else\n            PatrolRuntime_OnEncoderError(PATROL_ENCODER_ERROR_FORMAT);\n        taskEXIT_CRITICAL();\n        vTaskDelay(pdMS_TO_TICKS(read_config ? 500U : 100U));\n#else\n        vTaskDelay(pdMS_TO_TICKS(1000U));\n#endif\n    }\n}\n\n// 轮询云业务、共享远控安全与中位标定业务。按已有调度周期串行使用网络和维护上下文，耗时网络步骤不得替代独立安全任务。\nstatic void Patrol_RemoteTask(void *argument)\n{\n    (void)argument;\n    for (;;)\n    {\n        CloudService_Task();\n        RemoteService_Task();\n        CenterCalibration_Tick(HAL_GetTick());\n        vTaskDelay(pdMS_TO_TICKS(10U));\n    }\n}\n\n// 周期输出产品诊断日志。仅在相应诊断配置允许时运行，不在此修改运动控制许可。\nstatic void Patrol_DiagTask(void *argument)\n{\n    (void)argument;\n    for (;;)\n    {\n        AppLog_DebugTask();\n        vTaskDelay(pdMS_TO_TICKS(100U));\n    }\n}\n\n// 周期刷新独立看门狗并执行可选故障注入。故障测试路径按编译开关决定是否故意停止喂狗，正常路径维持主控存活监督。\nstatic void Patrol_WatchdogTask(void *argument)\n{\n    const EventBits_t required = PATROL_HEALTH_REQUIRED;\n    const TickType_t trial_started = xTaskGetTickCount();\n    (void)argument;\n    for (;;)\n    {\n#ifdef PATROL_CHASSIS_APP_FAULT_INJECTION_TEST\n        if (AppTest_WatchdogStep() != 0U) {\n            for (;;) vTaskDelay(pdMS_TO_TICKS(100U));\n        }\n#endif\n        EventBits_t healthy = xEventGroupWaitBits(g_health_events, required, pdTRUE, pdTRUE,\n                                                  pdMS_TO_TICKS(500U));\n        if ((healthy & required) == required)\n        {\n            (void)HAL_IWDG_Refresh(&hiwdg);\n            /* Do not require MQTT, 4G, or a vehicle CAN peer for trial success. */\n            if (g_boot_confirmed == 0U && (xTaskGetTickCount() - trial_started) >= pdMS_TO_TICKS(30000U) &&\n                (xEventGroupGetBits(g_health_events) & PATROL_EVENT_CAN_ERROR) == 0U)\n            {\n                g_boot_confirmed = BootState_Confirm();\n            }\n        }\n    }\n}\n\n// 处理 FreeRTOS 检测到的任务栈溢出。记录故障邮箱并进入安全终止路径，不能继续使用已可能损坏的任务栈执行业务。\nvoid vApplicationStackOverflowHook(TaskHandle_t task, char *task_name)\n{\n    (void)task;\n    (void)task_name;\n    taskDISABLE_INTERRUPTS();\n    PatrolFault_Record(PATROL_FAULT_STACK_OVERFLOW, 0U, 0U);\n    NVIC_SystemReset();\n    for (;;) {}\n}\n\n// 处理 FreeRTOS 内存分配失败。记录不可继续的运行故障并按既有终止路径退出，避免带不完整任务对象运行。\nvoid vApplicationMallocFailedHook(void)\n{\n    taskDISABLE_INTERRUPTS();\n    PatrolFault_Record(PATROL_FAULT_MALLOC_FAILED, 0U, 0U);\n    NVIC_SystemReset();\n    for (;;) {}\n}\n\n/* Hardware/RTOS boundary for the independently compiled motion modules. */\n// 向运动运行层提供 HAL 单调毫秒时钟。供超时和反馈年龄计算使用，不是 UTC 时间。\nuint32_t PatrolRuntimePort_Now(void) { return HAL_GetTick(); }\n// 进入可嵌套的运动共享状态临界区。应与 Exit 成对使用，禁止在保护区内执行 Flash 擦写或阻塞式外部等待。\nvoid PatrolRuntimePort_Enter(void) { taskENTER_CRITICAL(); }\n// 退出一层运动共享状态临界区。必须与当前任务先前 Enter 对应，不能跨任务或从不匹配的 ISR 上下文退出。\nvoid PatrolRuntimePort_Exit(void) { taskEXIT_CRITICAL(); }\n// 向运动层转发 CAN 故障门禁状态。复用 RTOS CAN 状态，不由运动模块另行推断控制器恢复。\nuint8_t PatrolRuntimePort_CanBusOff(void) { return PatrolRtos_CanBusOff(); }\n// 向运动层报告当前活动 Bus-Off。用于区分不能发送的底层故障与历史锁存，不表示旧会话可自动恢复。\nuint8_t PatrolRuntimePort_CanBusOffActive(void) { return PatrolRtos_CanBusOffActive(); }\n// 向运动层报告 OTA 是否占用受保护流程。忙状态参与运动禁止和 Flash 写入互斥，不允许在升级期间推进普通运动。\nuint8_t PatrolRuntimePort_OtaBusy(void) { return OtaService_IsBusy(); }\n// 检查当前 CAN 发送路径能否接受请求。只描述控制器与邮箱可用性，不代表目的节点在线或会响应。\nuint8_t PatrolRuntimePort_CanTxReady(void) { return HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0U; }\n// 中止尚在 CAN 邮箱排队的旧发送。用于撤权或停止时减少旧目标滞留，已发送到总线的命令仍须通过后续停车流程处理。\nvoid PatrolRuntimePort_AbortCanTx(void)\n{\n    (void)HAL_CAN_AbortTxRequest(&hcan1, CAN_TX_MAILBOX0 | CAN_TX_MAILBOX1 | CAN_TX_MAILBOX2);\n}\n// 将一条已仲裁的产品帧提交到 CAN 发送端口。返回 HAL 提交结果；调用方仍须处理发送失败和 SDO 超时，不得据返回成功宣称驱动器已执行。\nuint8_t PatrolRuntimePort_SendCan(const PatrolCanFrame* frame)\n{\n    CAN_TxHeaderTypeDef header = {0};\n    uint32_t mailbox;\n    /* The final CAN port rejects every motion frame in a non-actuating image. */\n    if (!PATROL_CHASSIS_ACTUATION_ENABLED &&\n        !(frame->id >= 0x601U && frame->id <= 0x602U && frame->data[0] == 0x40U))\n        return 0U;\n    header.StdId = frame->id;\n    header.IDE = CAN_ID_STD;\n    header.RTR = CAN_RTR_DATA;\n    header.DLC = frame->dlc;\n    header.TransmitGlobalTime = DISABLE;\n    return HAL_CAN_AddTxMessage(&hcan1, &header, (uint8_t*)frame->data, &mailbox) == HAL_OK;\n}\n\n#include "motion_internal.h"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include "app_log.h"\n#include "remote_service.h"\n#include "patrol_config.h"\n#include "vehicle_power_output.h"\n#include "vehicle_steering_profile.h"\n\n/* READY uses a human-scale idle timeout, independent of status polling. */\n#define CENTER_CAL_READY_IDLE_MS 600000U\n#define CENTER_CAL_DONE_OBSERVE_MS 60000U\n#ifndef PATROL_CHASSIS_ACTUATION_ENABLED\n#define PATROL_CHASSIS_ACTUATION_ENABLED 0\n#endif\n\n// 判断中位标定是否仍占用控制流程。按当前标定阶段判断，不以是否已经发送过点动命令推断活动状态。\nuint8_t CenterCalibration_IsActive(void)\n{\n    return g_motion.center_cal.phase != CENTER_CAL_IDLE &&\n        g_motion.center_cal.phase != CENTER_CAL_COMPLETE &&\n        g_motion.center_cal.phase != CENTER_CAL_FAILED && g_motion.center_cal.phase != CENTER_CAL_EXPIRED;\n}\n\n// 把内部标定原因编号转换为诊断名称。返回只读名称用于日志和内部查询，未知编号使用代码定义的兜底文本。\nstatic const char* center_reason_name(uint8_t reason)\n{\n    switch ((CenterCalibrationReason)reason) {\n    case CENTER_CAL_REASON_READY_LEASE_TIMEOUT: return "ready_lease_timeout";\n    case CENTER_CAL_REASON_PHASE_TIMEOUT: return "phase_timeout";\n    case CENTER_CAL_REASON_GATE_NOT_READY: return "gate_not_ready";\n    case CENTER_CAL_REASON_RELATIVE_MISMATCH: return "relative_mismatch";\n    case CENTER_CAL_REASON_BENCH_EXECUTOR_FAULT: return "steering_executor_fault";\n    case CENTER_CAL_REASON_COMMIT_BENCH_BUSY: return "commit_executor_busy";\n    case CENTER_CAL_REASON_COMMIT_STEERING_ENABLED: return "commit_steering_enabled";\n    case CENTER_CAL_REASON_CONFIG_CLEAR_FAILED: return "config_clear_failed";\n    case CENTER_CAL_REASON_ENCODER_TX_FAILED: return "encoder_tx_failed";\n    case CENTER_CAL_REASON_ENCODER_VERIFY_MISMATCH: return "encoder_verify_mismatch";\n    case CENTER_CAL_REASON_CONFIG_SAVE_FAILED: return "config_save_failed";\n    case CENTER_CAL_REASON_WRONG_PHASE: return "wrong_phase";\n    case CENTER_CAL_REASON_SESSION_MISMATCH: return "session_mismatch";\n    case CENTER_CAL_REASON_INVALID_JOG_DELTA: return "invalid_jog_delta";\n    case CENTER_CAL_REASON_JOG_LIMIT: return "jog_limit";\n    case CENTER_CAL_REASON_ALREADY_ACTIVE: return "already_active";\n    case CENTER_CAL_REASON_ENCODER_OUT_OF_RANGE: return "encoder_out_of_range";\n    case CENTER_CAL_REASON_EXECUTOR_BUSY: return "executor_busy";\n    case CENTER_CAL_REASON_POSITION_EPOCH_RESET: return "position_epoch_reset";\n    default: return "none";\n    }\n}\n\n// 把标定失败原因映射为业务可读状态。对外响应使用稳定业务语义，内部故障细节继续保留在诊断快照中。\nstatic const char* center_business_reason(uint8_t reason)\n{\n    switch ((CenterCalibrationReason)reason) {\n    case CENTER_CAL_REASON_NONE: return "NONE";\n    case CENTER_CAL_REASON_READY_LEASE_TIMEOUT: return "EXPIRED";\n    case CENTER_CAL_REASON_WRONG_PHASE:\n    case CENTER_CAL_REASON_ALREADY_ACTIVE: return "INVALID_STATE";\n    case CENTER_CAL_REASON_SESSION_MISMATCH: return "SESSION_MISMATCH";\n    case CENTER_CAL_REASON_GATE_NOT_READY:\n    case CENTER_CAL_REASON_EXECUTOR_BUSY:\n    case CENTER_CAL_REASON_COMMIT_BENCH_BUSY:\n    case CENTER_CAL_REASON_COMMIT_STEERING_ENABLED: return "SAFETY_BLOCKED";\n    case CENTER_CAL_REASON_INVALID_JOG_DELTA:\n    case CENTER_CAL_REASON_JOG_LIMIT:\n    case CENTER_CAL_REASON_ENCODER_OUT_OF_RANGE: return "OUT_OF_RANGE";\n    case CENTER_CAL_REASON_CONFIG_CLEAR_FAILED:\n    case CENTER_CAL_REASON_CONFIG_SAVE_FAILED: return "PERSIST_FAILED";\n    default: return "EXECUTION_FAILED";\n    }\n}\n\n// 汇总标定阶段所需的全部安全门禁位。检查供电、CAN、OTA、节点、双反馈、编码器、车轮运动、会话及执行器状态；require_steering_disabled 控制是否要求转向撤使能。\nuint32_t CenterCalibration_GateMask(const PatrolDiagnosticsSnapshot* s,\n                                 uint8_t require_steering_disabled)\n{\n    const ChassisControl* c = RemoteService_State();\n    uint32_t mask = 0U;\n    if (s == NULL || c == NULL) return UINT32_MAX;\n    if (!PATROL_CHASSIS_ACTUATION_ENABLED) mask |= CENTER_GATE_ACTUATION_DISABLED;\n    if (!VehiclePowerOutput_IsOn()) mask |= CENTER_GATE_POWER_OFF;\n    if (PatrolRuntimePort_CanBusOff()) mask |= CENTER_GATE_CAN_BUS_OFF;\n    if (PatrolRuntimePort_CanBusOffActive()) mask |= CENTER_GATE_CAN_BUS_OFF_ACTIVE;\n    if (PatrolRuntimePort_OtaBusy()) mask |= CENTER_GATE_OTA_BUSY;\n    if (!s->steering_online) mask |= CENTER_GATE_STEERING_OFFLINE;\n    if (!s->drive_online) mask |= CENTER_GATE_DRIVE_OFFLINE;\n    if (!s->steering_feedback_fresh) mask |= CENTER_GATE_STEERING_FEEDBACK_STALE;\n    if (!s->drive_feedback_fresh) mask |= CENTER_GATE_DRIVE_FEEDBACK_STALE;\n    if (!s->steering_status_fresh) mask |= CENTER_GATE_STEERING_STATUS_STALE;\n    if (!s->drive_status_fresh) mask |= CENTER_GATE_DRIVE_STATUS_STALE;\n    if (!s->encoder_online) mask |= CENTER_GATE_ENCODER_OFFLINE;\n    if (!s->encoder_config_valid) mask |= CENTER_GATE_ENCODER_CONFIG_INVALID;\n    if (s->drive_fault) mask |= CENTER_GATE_DRIVE_FAULT;\n    if (labs(s->left_actual_rpm) > 20L || labs(s->right_actual_rpm) > 20L)\n        mask |= CENTER_GATE_WHEELS_MOVING;\n    if (c->session_active) mask |= CENTER_GATE_CONTROL_SESSION_ACTIVE;\n    if (c->enable_request) mask |= CENTER_GATE_CONTROL_ENABLE_ACTIVE;\n    if ((s->drive_status_word & 0x006FU) == 0x0027U)\n        mask |= CENTER_GATE_DRIVE_OPERATION_ENABLED;\n    if (c->fault_latched || c->fault_pending) mask |= CENTER_GATE_FAULT_LATCHED;\n    if (ChassisControl_RuntimeSafetyReason(c, PatrolRuntimePort_Now()) != CHASSIS_STOP_NONE)\n        mask |= CENTER_GATE_RUNTIME_UNSAFE;\n    if (require_steering_disabled && (s->steering_status_word & 0x006FU) == 0x0027U)\n        mask |= CENTER_GATE_STEERING_OPERATION_ENABLED;\n    return mask;\n}\n\n// 记录在当前标定上下文中被拒绝的请求原因。调用时应已持有运行层锁，保存原因和门禁供响应查询，不自行执行运动。\nstatic void center_reject_locked(CenterCalibrationReason reason, uint32_t gate_mask)\n{\n    g_motion.center_cal.last_reject_reason = (uint8_t)reason;\n    g_motion.center_cal.last_reject_gate_mask = gate_mask;\n    g_motion.center_cal.last_reject_ms = PatrolRuntimePort_Now();\n}\n\n// 检查给定诊断快照能否继续标定操作。使用统一标定门禁并结合是否要求转向禁用，防止不同入口使用不一致的安全前提。\nstatic uint8_t center_feedback_ready(const PatrolDiagnosticsSnapshot* s,\n                                     uint8_t require_steering_disabled)\n{\n    return CenterCalibration_GateMask(s, require_steering_disabled) == 0U ? 1U : 0U;\n}\n\n// 从本轮起点计算驱动器和编码器相对角度。只在本次标定坐标成立时更新，并保留双传感器一致性判断所需的独立结果。\nvoid CenterCalibration_UpdateRelative(const PatrolDiagnosticsSnapshot* s)\n{\n    if (s == NULL || g_motion.center_cal.phase == CENTER_CAL_IDLE ||\n        g_motion.center_cal.phase == CENTER_CAL_COMPLETE || g_motion.center_cal.phase == CENTER_CAL_FAILED ||\n        g_motion.center_cal.phase == CENTER_CAL_EXPIRED) return;\n    if (s->encoder_count >= VEHICLE_ABSOLUTE_SINGLE_TURN_COUNTS) {\n        g_motion.center_cal.relative_valid = 0U;\n        return;\n    }\n    if (s->encoder_sample_ms != 0U && s->encoder_sample_ms != g_motion.center_cal.last_encoder_sample_ms) {\n        /* A larger one-sample jump cannot be produced by the bounded 100 rpm\n         * commissioning jog and is treated as an encoder discontinuity. */\n        if (!SteeringAngle_AccumulateSingleTurn(g_motion.center_cal.last_encoder_count,\n                s->encoder_count, VEHICLE_ABSOLUTE_SINGLE_TURN_COUNTS, 256U,\n                &g_motion.center_cal.encoder_delta_count))\n            g_motion.center_cal.relative_valid = 0U;\n        g_motion.center_cal.last_encoder_count = s->encoder_count;\n        g_motion.center_cal.last_encoder_sample_ms = s->encoder_sample_ms;\n    }\n    g_motion.center_cal.driver_relative_mdeg = SteeringAngle_FromControllerCount(\n        s->steering_position_count, g_motion.center_cal.start_driver_count,\n        VEHICLE_STEERING_COUNTS_MILLI, VEHICLE_STEERING_DIRECTION);\n    g_motion.center_cal.encoder_relative_mdeg = SteeringAngle_FromControllerCount(\n        g_motion.center_cal.encoder_delta_count, 0, VEHICLE_ABSOLUTE_COUNTS_MILLI,\n        VEHICLE_ABSOLUTE_DIRECTION);\n    if (llabs((int64_t)g_motion.center_cal.driver_relative_mdeg -\n              g_motion.center_cal.encoder_relative_mdeg) > VEHICLE_STEERING_TOLERANCE_MDEG)\n        g_motion.center_cal.relative_valid = 0U;\n}\n\n// 在标定失败瞬间冻结诊断证据。调用方持锁，记录时间、门禁、阶段、执行器、原始计数和错误；后续状态变化不应改写首因证据。\nvoid CenterCalibration_CaptureFailureLocked(CenterCalibrationReason reason, uint32_t gate_mask,\n                                          uint32_t now,\n                                          const PatrolDiagnosticsSnapshot* snapshot)\n{\n    if (g_motion.center_cal.failure.reason != CENTER_CAL_REASON_NONE) return;\n    PatrolRuntime_CaptureFault(2U, (uint32_t)reason, gate_mask);\n    g_motion.center_cal.failure.phase = (uint8_t)g_motion.center_cal.phase;\n    g_motion.center_cal.failure.reason = (uint8_t)reason;\n    g_motion.center_cal.failure.at_ms = now;\n    g_motion.center_cal.failure.gate_mask = gate_mask;\n    g_motion.center_cal.failure.bench_phase = (uint8_t)g_motion.bench.phase;\n    g_motion.center_cal.failure.bench_step = g_motion.bench.step;\n    g_motion.center_cal.failure.bench_fault = g_motion.bench.fault;\n    g_motion.center_cal.failure.encoder_write_state = g_motion.center_cal.encoder_write_state;\n    if (snapshot != NULL) {\n        uint64_t encoder_errors = (uint64_t)snapshot->encoder_timeout_count +\n            snapshot->encoder_crc_error_count + snapshot->encoder_exception_count +\n            snapshot->encoder_format_error_count + snapshot->encoder_transport_error_count;\n        g_motion.center_cal.failure.driver_raw = snapshot->steering_position_count;\n        g_motion.center_cal.failure.encoder_raw = snapshot->encoder_count;\n        g_motion.center_cal.failure.left_rpm = snapshot->left_actual_rpm;\n        g_motion.center_cal.failure.right_rpm = snapshot->right_actual_rpm;\n        g_motion.center_cal.failure.feedback_age_ms = snapshot->coherent_feedback_ms == 0U ?\n            UINT32_MAX : now - snapshot->coherent_feedback_ms;\n        g_motion.center_cal.failure.encoder_age_ms = snapshot->encoder_sample_ms == 0U ?\n            UINT32_MAX : now - snapshot->encoder_sample_ms;\n        g_motion.center_cal.failure.encoder_error_total = encoder_errors > UINT32_MAX ?\n            UINT32_MAX : (uint32_t)encoder_errors;\n        g_motion.center_cal.failure.encoder_error = snapshot->last_encoder_error;\n        g_motion.center_cal.failure.steering_status_word = snapshot->steering_status_word;\n        g_motion.center_cal.failure.drive_status_word = snapshot->drive_status_word;\n        g_motion.center_cal.failure.last_sdo_abort = snapshot->last_sdo_abort_code;\n    }\n}\n\n// 统一终止标定并关联执行器故障。保存失败快照并撤销后续标定动作，交由运行层安全停机；不把软件终止等同于物理停止。\nvoid CenterCalibration_Fail(uint32_t fault, CenterCalibrationReason reason,\n                                    const PatrolDiagnosticsSnapshot* snapshot,\n                                    uint32_t gate_mask)\n{\n    uint32_t now = PatrolRuntimePort_Now();\n    PatrolRuntimePort_Enter();\n    CenterCalibration_CaptureFailureLocked(reason, gate_mask, now, snapshot);\n    g_motion.center_cal.phase = CENTER_CAL_FAILED;\n    g_motion.center_cal.fault = fault;\n    g_motion.center_cal.encoder_write_state = 0U;\n    if (g_motion.bench.phase != BENCH_IDLE)\n        BenchSteering_Stop(&g_motion.bench, PatrolRuntimePort_Now(), 1U);\n    SteeringCoordinate_Reset(&g_motion.coordinate);\n    PatrolRuntimePort_Exit();\n    RemoteService_ExecutionFault();\n    if (!RemoteService_State()->fault_pending) (void)VehiclePowerOutput_Set(0U);\n    APP_LOGE("CENTER_CAL", "fail phase=%u fault=%lu reason=%s gate=%lu bench=%u/%u/%lu enc=%u",\n        (unsigned int)g_motion.center_cal.failure.phase, (unsigned long)fault,\n        center_reason_name(g_motion.center_cal.failure.reason), (unsigned long)gate_mask,\n        (unsigned int)g_motion.center_cal.failure.bench_phase,\n        (unsigned int)g_motion.center_cal.failure.bench_step,\n        (unsigned long)g_motion.center_cal.failure.bench_fault,\n        (unsigned int)g_motion.center_cal.failure.encoder_write_state);\n}\n\n// 在仍可发送停车报文时登记故障停车请求。保留标定执行器对 STOPPING 的归属，避免在未标定状态下误用普通运动门禁而跳过有序停机。\nvoid CenterCalibration_RequestStopForFault(CenterCalibrationReason reason, uint32_t gate_mask,\n                                          uint32_t now)\n{\n    PatrolRuntimePort_Enter();\n    if ((g_motion.center_cal.phase == CENTER_CAL_JOGGING ||\n         g_motion.center_cal.phase == CENTER_CAL_STOPPING) &&\n        !g_motion.center_cal.stop_fault_pending) {\n        g_motion.center_cal.stop_fault_pending = 1U;\n        g_motion.center_cal.stop_fault_reason = (uint8_t)reason;\n        g_motion.center_cal.stop_gate_mask = gate_mask;\n        BenchSteering_Stop(&g_motion.bench, now, 0U);\n        g_motion.center_cal.phase = CENTER_CAL_STOPPING;\n        g_motion.center_cal.deadline_ms = now + 2000U;\n    }\n    PatrolRuntimePort_Exit();\n}\n\n// 处理准备阶段空闲或租约超时。超时后不保留可继续点动的旧授权，返回是否已触发过期处理。\nstatic uint8_t center_calibration_expire_idle(uint32_t now)\n{\n    uint8_t expired = 0U;\n    PatrolRuntimePort_Enter();\n    if (g_motion.center_cal.phase == CENTER_CAL_READY && g_motion.bench.phase == BENCH_IDLE &&\n        (int32_t)(now - g_motion.center_cal.deadline_ms) >= 0) {\n        /* No motion was requested. Expiry is a session outcome, not a device fault. */\n        center_reject_locked(CENTER_CAL_REASON_READY_LEASE_TIMEOUT, 0U);\n        g_motion.center_cal.phase = CENTER_CAL_EXPIRED;\n        g_motion.center_cal.session_id[0] = \'\\0\';\n        g_motion.center_cal.fault = 0U;\n        g_motion.center_cal.encoder_write_state = 0U;\n        SteeringCoordinate_Reset(&g_motion.coordinate);\n        expired = 1U;\n    }\n    PatrolRuntimePort_Exit();\n    if (expired) {\n        RemoteService_Revoke();\n        (void)VehiclePowerOutput_Set(0U);\n        APP_LOGW("CENTER_CAL", "idle lease expired");\n    }\n    return expired;\n}\n\n// 在全部前置门禁通过后建立新的中位标定会话。拒绝已有活动标定或执行器占用，记录起始双传感器坐标和会话期限；此时尚未完成永久标定。\nuint8_t CenterCalibration_Start(void)\n{\n    PatrolDiagnosticsSnapshot s;\n    uint32_t now = PatrolRuntimePort_Now();\n    uint32_t gate_mask;\n    PatrolRuntime_GetDiagnostics(&s);\n    gate_mask = CenterCalibration_GateMask(&s, 1U);\n    PatrolRuntimePort_Enter();\n    if (g_motion.bench.phase != BENCH_IDLE) gate_mask |= CENTER_GATE_BENCH_EXECUTOR_BUSY;\n    if (g_motion.drive.phase != BENCH_IDLE) gate_mask |= CENTER_GATE_DRIVE_EXECUTOR_BUSY;\n    if (s.encoder_count >= VEHICLE_ABSOLUTE_SINGLE_TURN_COUNTS)\n        gate_mask |= CENTER_GATE_ENCODER_OUT_OF_RANGE;\n    if ((g_motion.center_cal.phase != CENTER_CAL_IDLE &&\n         g_motion.center_cal.phase != CENTER_CAL_EXPIRED &&\n         g_motion.center_cal.phase != CENTER_CAL_COMPLETE) || gate_mask != 0U) {\n        CenterCalibrationReason reason = CENTER_CAL_REASON_GATE_NOT_READY;\n        if (g_motion.center_cal.phase != CENTER_CAL_IDLE &&\n            g_motion.center_cal.phase != CENTER_CAL_EXPIRED &&\n            g_motion.center_cal.phase != CENTER_CAL_COMPLETE)\n            reason = CENTER_CAL_REASON_ALREADY_ACTIVE;\n        else if (gate_mask & CENTER_GATE_ENCODER_OUT_OF_RANGE)\n            reason = CENTER_CAL_REASON_ENCODER_OUT_OF_RANGE;\n        else if (gate_mask & (CENTER_GATE_BENCH_EXECUTOR_BUSY | CENTER_GATE_DRIVE_EXECUTOR_BUSY))\n            reason = CENTER_CAL_REASON_EXECUTOR_BUSY;\n        center_reject_locked(reason, gate_mask);\n        PatrolRuntimePort_Exit();\n        return 0U;\n    }\n    PatrolRuntime_BeginFaultEpisode();\n    memset(&g_motion.center_cal, 0, sizeof(g_motion.center_cal));\n    /* Commissioning owns its captured relative origin.  Do not retain or\n     * later acquire the ordinary driving coordinate using an old calibration. */\n    SteeringCoordinate_Reset(&g_motion.coordinate);\n    g_motion.bench.limits_aligned = 0U;\n    g_motion.center_cal.serial = ++g_motion.center_cal_serial;\n    g_motion.center_cal.phase = CENTER_CAL_START_STABLE;\n    g_motion.center_cal.start_driver_count = s.steering_position_count;\n    g_motion.center_cal.last_encoder_count = s.encoder_count;\n    g_motion.center_cal.last_encoder_sample_ms = s.encoder_sample_ms;\n    g_motion.center_cal.relative_valid = 1U;\n    g_motion.center_cal.start_mdeg = 0;\n    g_motion.center_cal.target_mdeg = 0;\n    g_motion.center_cal.deadline_ms = now + 7000U;\n    (void)snprintf(g_motion.center_cal.session_id, sizeof(g_motion.center_cal.session_id), "c-%lu-%lu",\n                   (unsigned long)now, (unsigned long)g_motion.center_cal.serial);\n    PatrolRuntimePort_Exit();\n    return 1U;\n}\n\n// 验证请求是否属于当前标定会话。比较有效会话标识，防止过期页面或其他控制者接续旧标定动作。\nstatic uint8_t center_session_matches(const char* session_id)\n{\n    return session_id != NULL && session_id[0] != \'\\0\' &&\n        strcmp(session_id, g_motion.center_cal.session_id) == 0;\n}\n\n// 续租当前有效的标定会话。仅对匹配会话和允许阶段生效，不能以保活绕过实际反馈门禁或恢复已终止流程。\nuint8_t CenterCalibration_KeepAlive(const char* session_id)\n{\n    uint8_t accepted;\n    PatrolRuntimePort_Enter();\n    accepted = g_motion.center_cal.phase != CENTER_CAL_IDLE &&\n        g_motion.center_cal.phase != CENTER_CAL_EXPIRED && center_session_matches(session_id);\n    if (!accepted)\n        center_reject_locked(g_motion.center_cal.phase == CENTER_CAL_IDLE ?\n            CENTER_CAL_REASON_WRONG_PHASE : CENTER_CAL_REASON_SESSION_MISMATCH, 0U);\n    else {\n        /* A read/keepalive is not a successful retry of the rejected command. */\n        /* Reading status never extends the READY idle deadline. */\n    }\n    PatrolRuntimePort_Exit();\n    return accepted;\n}\n\n// 申请一次受限的标定相对点动。核验会话、阶段、安全门禁和增量幅度，再更新本次相对目标；驱动器与编码器反馈随后独立验证位移。\nuint8_t CenterCalibration_Jog(const char* session_id, int16_t delta_mdeg)\n{\n    PatrolDiagnosticsSnapshot s;\n    int32_t next;\n    uint32_t gate_mask;\n    uint8_t valid_delta;\n    PatrolRuntime_GetDiagnostics(&s);\n    gate_mask = CenterCalibration_GateMask(&s, 0U);\n    valid_delta = (uint8_t)(delta_mdeg == VEHICLE_CENTER_JOG_FINE_MDEG ||\n        delta_mdeg == -VEHICLE_CENTER_JOG_FINE_MDEG ||\n        delta_mdeg == VEHICLE_CENTER_JOG_COARSE_MDEG ||\n        delta_mdeg == -VEHICLE_CENTER_JOG_COARSE_MDEG ||\n        delta_mdeg == VEHICLE_CENTER_JOG_LARGE_MDEG ||\n        delta_mdeg == -VEHICLE_CENTER_JOG_LARGE_MDEG);\n    PatrolRuntimePort_Enter();\n    next = g_motion.center_cal.accumulated_mdeg + delta_mdeg;\n    if (g_motion.center_cal.phase != CENTER_CAL_READY || !center_session_matches(session_id) ||\n        !valid_delta || labs(next) > VEHICLE_CENTER_COMMISSIONING_LIMIT_MDEG ||\n        !g_motion.center_cal.relative_valid || gate_mask != 0U) {\n        CenterCalibrationReason reason = CENTER_CAL_REASON_GATE_NOT_READY;\n        if (g_motion.center_cal.phase != CENTER_CAL_READY) reason = CENTER_CAL_REASON_WRONG_PHASE;\n        else if (!center_session_matches(session_id)) reason = CENTER_CAL_REASON_SESSION_MISMATCH;\n        else if (!valid_delta) reason = CENTER_CAL_REASON_INVALID_JOG_DELTA;\n        else if (labs(next) > VEHICLE_CENTER_COMMISSIONING_LIMIT_MDEG)\n            reason = CENTER_CAL_REASON_JOG_LIMIT;\n        else if (!g_motion.center_cal.relative_valid) reason = CENTER_CAL_REASON_RELATIVE_MISMATCH;\n        center_reject_locked(reason, gate_mask);\n        PatrolRuntimePort_Exit();\n        return 0U;\n    }\n    g_motion.center_cal.last_reject_reason = CENTER_CAL_REASON_NONE;\n    g_motion.center_cal.accumulated_mdeg = next;\n    g_motion.center_cal.target_mdeg = g_motion.center_cal.start_mdeg + next;\n    g_motion.center_cal.stable_samples = 0U;\n    g_motion.center_cal.last_sample_ms = 0U;\n    g_motion.center_cal.deadline_ms = PatrolRuntimePort_Now() + 7000U;\n    g_motion.center_cal.phase = CENTER_CAL_JOGGING;\n    PatrolRuntimePort_Exit();\n    return 1U;\n}\n\n// 申请把已确认的机械中位保存为正式标定。要求匹配会话、执行器停止及撤使能等前提，协调编码器写入复读和 Config V5 保存，不在请求接受时宣称已落盘。\nuint8_t CenterCalibration_Commit(const char* session_id)\n{\n    PatrolDiagnosticsSnapshot s;\n    uint32_t gate_mask;\n    PatrolRuntime_GetDiagnostics(&s);\n    gate_mask = CenterCalibration_GateMask(&s, 1U);\n    PatrolRuntimePort_Enter();\n    if (g_motion.center_cal.phase != CENTER_CAL_READY || !center_session_matches(session_id) ||\n        g_motion.bench.phase != BENCH_IDLE || gate_mask != 0U) {\n        CenterCalibrationReason reason = CENTER_CAL_REASON_GATE_NOT_READY;\n        if (g_motion.center_cal.phase != CENTER_CAL_READY) reason = CENTER_CAL_REASON_WRONG_PHASE;\n        else if (!center_session_matches(session_id)) reason = CENTER_CAL_REASON_SESSION_MISMATCH;\n        else if (g_motion.bench.phase != BENCH_IDLE) reason = CENTER_CAL_REASON_COMMIT_BENCH_BUSY;\n        else if (gate_mask & CENTER_GATE_STEERING_OPERATION_ENABLED)\n            reason = CENTER_CAL_REASON_COMMIT_STEERING_ENABLED;\n        center_reject_locked(reason, gate_mask);\n        PatrolRuntimePort_Exit();\n        return 0U;\n    }\n    g_motion.center_cal.last_reject_reason = CENTER_CAL_REASON_NONE;\n    g_motion.center_cal.phase = CENTER_CAL_COMMIT_STABLE;\n    g_motion.center_cal.stable_samples = 0U;\n    g_motion.center_cal.last_sample_ms = 0U;\n    g_motion.center_cal.deadline_ms = PatrolRuntimePort_Now() + 7000U;\n    PatrolRuntimePort_Exit();\n    return 1U;\n}\n\n// 取消指定会话的标定操作。按当前阶段执行安全退出或有序停车；旧会话不能取消新会话占用。\nuint8_t CenterCalibration_Cancel(const char* session_id)\n{\n    PatrolRuntimePort_Enter();\n    if (g_motion.center_cal.phase == CENTER_CAL_IDLE || !center_session_matches(session_id)) {\n        center_reject_locked(g_motion.center_cal.phase == CENTER_CAL_IDLE ?\n            CENTER_CAL_REASON_WRONG_PHASE : CENTER_CAL_REASON_SESSION_MISMATCH, 0U);\n        PatrolRuntimePort_Exit();\n        return 0U;\n    }\n    if (g_motion.bench.phase != BENCH_IDLE) {\n        BenchSteering_Stop(&g_motion.bench, PatrolRuntimePort_Now(), 0U);\n        g_motion.center_cal.phase = CENTER_CAL_STOPPING;\n        g_motion.center_cal.cancel_requested = 1U;\n        g_motion.center_cal.deadline_ms = PatrolRuntimePort_Now() + 2000U;\n        PatrolRuntimePort_Exit();\n        return 1U;\n    }\n    memset(&g_motion.center_cal, 0, sizeof(g_motion.center_cal));\n    PatrolRuntimePort_Exit();\n    RemoteService_Revoke();\n    (void)VehiclePowerOutput_Set(0U);\n    return 1U;\n}\n\n// 输出标定内部诊断及最近失败证据。使用有界缓冲区给出门禁、阶段、相对角度和错误，不改变标定状态。\nuint8_t CenterCalibration_FormatDiagnostics(char* out, uint16_t size)\n{\n    PatrolDiagnosticsSnapshot s;\n    const ChassisControl* c = RemoteService_State();\n    int length;\n    PatrolRuntime_GetDiagnostics(&s);\n    PatrolRuntimePort_Enter();\n    length = snprintf(out, size,\n        "{\\"phase\\":%u,\\"sessionId\\":\\"%s\\",\\"detailReason\\":\\"%s\\",\\"fault\\":%lu,\\"driverRaw\\":%ld,"\n        "\\"encoderRaw\\":%lu,\\"targetMdeg\\":%ld,\\"jogOffsetMdeg\\":%ld,"\n        "\\"profileReady\\":%s,\\"rangeValid\\":%s,\\"calibrated\\":%s,"\n        "\\"driverRelativeMdeg\\":%ld,\\"encoderRelativeMdeg\\":%ld,"\n        "\\"relativeValid\\":%s,\\"commissioningLimitMdeg\\":%ld,\\"diagVersion\\":1,"\n        "\\"failure\\":{\\"phase\\":%u,\\"reason\\":\\"%s\\",\\"atMs\\":%lu,\\"gateMask\\":%lu,"\n        "\\"driverRaw\\":%ld,\\"encoderRaw\\":%lu,\\"leftRpm\\":%ld,\\"rightRpm\\":%ld,"\n        "\\"feedbackAge\\":%lu,\\"encoderAge\\":%lu,\\"encoderErrTotal\\":%lu,"\n        "\\"steeringExecutorPhase\\":%u,\\"steeringExecutorStep\\":%u,\\"steeringExecutorFault\\":%lu,"\n        "\\"encoderWrite\\":%u,\\"encoderError\\":%u,\\"steerSw\\":%u,"\n        "\\"driveSw\\":%u,\\"lastAbort\\":%lu},"\n        "\\"lastReject\\":{\\"reason\\":\\"%s\\",\\"atMs\\":%lu,\\"gateMask\\":%lu}}",\n        (unsigned)g_motion.center_cal.phase, g_motion.center_cal.session_id,\n        center_reason_name(g_motion.center_cal.failure.reason != CENTER_CAL_REASON_NONE ?\n            g_motion.center_cal.failure.reason : g_motion.center_cal.last_reject_reason),\n        (unsigned long)g_motion.center_cal.fault,\n        (long)s.steering_position_count, (unsigned long)s.encoder_count,\n        (long)g_motion.center_cal.target_mdeg, (long)g_motion.center_cal.accumulated_mdeg,\n        PatrolConfig_SingleTurnProfileReady() ? "true" : "false",\n        c->feedback.encoder_range_valid ? "true" : "false",\n        PatrolConfig_Get()->calibrated ? "true" : "false",\n        (long)g_motion.center_cal.driver_relative_mdeg, (long)g_motion.center_cal.encoder_relative_mdeg,\n        g_motion.center_cal.relative_valid ? "true" : "false",\n        (long)VEHICLE_CENTER_COMMISSIONING_LIMIT_MDEG,\n        (unsigned int)g_motion.center_cal.failure.phase,\n        center_reason_name(g_motion.center_cal.failure.reason),\n        (unsigned long)g_motion.center_cal.failure.at_ms,\n        (unsigned long)g_motion.center_cal.failure.gate_mask,\n        (long)g_motion.center_cal.failure.driver_raw,\n        (unsigned long)g_motion.center_cal.failure.encoder_raw,\n        (long)g_motion.center_cal.failure.left_rpm,\n        (long)g_motion.center_cal.failure.right_rpm,\n        (unsigned long)g_motion.center_cal.failure.feedback_age_ms,\n        (unsigned long)g_motion.center_cal.failure.encoder_age_ms,\n        (unsigned long)g_motion.center_cal.failure.encoder_error_total,\n        (unsigned int)g_motion.center_cal.failure.bench_phase,\n        (unsigned int)g_motion.center_cal.failure.bench_step,\n        (unsigned long)g_motion.center_cal.failure.bench_fault,\n        (unsigned int)g_motion.center_cal.failure.encoder_write_state,\n        (unsigned int)g_motion.center_cal.failure.encoder_error,\n        (unsigned int)g_motion.center_cal.failure.steering_status_word,\n        (unsigned int)g_motion.center_cal.failure.drive_status_word,\n        (unsigned long)g_motion.center_cal.failure.last_sdo_abort,\n        center_reason_name(g_motion.center_cal.last_reject_reason),\n        (unsigned long)g_motion.center_cal.last_reject_ms,\n        (unsigned long)g_motion.center_cal.last_reject_gate_mask);\n    PatrolRuntimePort_Exit();\n    return (uint8_t)(length >= 0 && length < size);\n}\n\n// 输出当前标定业务状态与会话信息。供响应构造使用；返回格式化结果，不代表标定提交或真实转向已通过验收。\nuint8_t CenterCalibration_Format(char* out, uint16_t size)\n{\n    const CenterCalibration* cal = &g_motion.center_cal;\n    const char* state = "IDLE";\n    const char* reason = "NONE";\n    int length;\n    PatrolRuntimePort_Enter();\n    if (cal->phase == CENTER_CAL_READY) state = "READY";\n    else if (cal->phase == CENTER_CAL_COMPLETE) state = "DONE";\n    else if (cal->phase == CENTER_CAL_FAILED) state = "ERROR";\n    else if (CenterCalibration_IsActive()) state = "BUSY";\n    if (cal->phase == CENTER_CAL_EXPIRED) reason = "EXPIRED";\n    else if (cal->phase == CENTER_CAL_FAILED) reason = center_business_reason(cal->failure.reason);\n    else if (cal->last_reject_reason != CENTER_CAL_REASON_NONE)\n        reason = center_business_reason(cal->last_reject_reason);\n    length = snprintf(out, size,\n        "{\\"state\\":\\"%s\\",\\"sessionId\\":\\"%s\\",\\"calibrated\\":%s,"\n        "\\"reason\\":\\"%s\\",\\"jogOffsetMdeg\\":%ld}",\n        state, cal->session_id, PatrolConfig_SingleTurnProfileReady() ? "true" : "false",\n        reason, (long)cal->accumulated_mdeg);\n    PatrolRuntimePort_Exit();\n    return (uint8_t)(length >= 0 && length < size);\n}\n\n// 返回当前会话标识的只读视图。调用方须在运行临界区内完成匹配或后续调用，不能保存指针。\nconst char* CenterCalibration_SessionId(void)\n{\n    return g_motion.center_cal.session_id;\n}\n\n// 汇总标定阶段、最近失败原因和双传感器原始值。仅供状态显示，不能据此认定电机已停止或标定已落盘。\nuint8_t CenterCalibration_GetStatus(CenterCalibrationStatus* status)\n{\n    PatrolDiagnosticsSnapshot snapshot;\n    if (status == NULL) return 0U;\n    PatrolRuntime_GetDiagnostics(&snapshot);\n    PatrolRuntimePort_Enter();\n    status->phase = (uint8_t)g_motion.center_cal.phase;\n    status->reason = g_motion.center_cal.failure.reason != CENTER_CAL_REASON_NONE ?\n        g_motion.center_cal.failure.reason : g_motion.center_cal.last_reject_reason;\n    status->active = CenterCalibration_IsActive();\n    status->calibrated = PatrolConfig_Get()->calibrated;\n    status->driver_raw = snapshot.steering_position_count;\n    status->encoder_raw = snapshot.encoder_count;\n    status->jog_offset_mdeg = g_motion.center_cal.accumulated_mdeg;\n    status->saved_center_count = PatrolConfig_Get()->steering_center_count;\n    PatrolRuntimePort_Exit();\n    return 1U;\n}\n\n// 推进标定超时、停车、编码器校验及保存阶段。持续监督门禁与双反馈一致性，仅在所需确认全部成立后推进提交，失败走统一证据捕获与安全退出。\nvoid CenterCalibration_Tick(uint32_t now)\n{\n    PatrolDiagnosticsSnapshot s;\n    CenterCalibrationPhase phase = g_motion.center_cal.phase;\n    uint32_t gate_mask;\n    now = PatrolRuntimePort_Now();\n    if (phase == CENTER_CAL_COMPLETE) {\n        if ((int32_t)(now - g_motion.center_cal.deadline_ms) >= 0) {\n            PatrolRuntimePort_Enter();\n            if (g_motion.center_cal.phase == CENTER_CAL_COMPLETE)\n                memset(&g_motion.center_cal, 0, sizeof(g_motion.center_cal));\n            PatrolRuntimePort_Exit();\n        }\n        return;\n    }\n    if (phase == CENTER_CAL_IDLE || phase == CENTER_CAL_FAILED || phase == CENTER_CAL_EXPIRED) return;\n    PatrolRuntime_GetDiagnostics(&s);\n    /* Never subtract a newer RX sample from an older task timestamp. */\n    gate_mask = CenterCalibration_GateMask(&s,\n        (uint8_t)(phase == CENTER_CAL_START_STABLE || phase == CENTER_CAL_COMMIT_STABLE));\n    /* READY is idle, not immune to a terminal fault.  Keep transient stale\n     * samples as motion gates, but never advertise READY after power/fault loss. */\n    if (g_motion.bench.phase == BENCH_FAULT || g_motion.drive.phase == BENCH_FAULT) {\n        CenterCalibration_Fail(2U, CENTER_CAL_REASON_BENCH_EXECUTOR_FAULT, &s, gate_mask);\n        return;\n    }\n    if (gate_mask & (CENTER_GATE_POWER_OFF | CENTER_GATE_CAN_BUS_OFF |\n                    CENTER_GATE_CAN_BUS_OFF_ACTIVE | CENTER_GATE_OTA_BUSY)) {\n        CenterCalibration_Fail(2U, CENTER_CAL_REASON_GATE_NOT_READY, &s, gate_mask);\n        return;\n    }\n    if (phase == CENTER_CAL_READY && !g_motion.center_cal.relative_valid) {\n        CenterCalibration_Fail(2U, CENTER_CAL_REASON_RELATIVE_MISMATCH, &s, gate_mask);\n        return;\n    }\n    if ((int32_t)(now - g_motion.center_cal.deadline_ms) >= 0) {\n        if (phase == CENTER_CAL_READY && center_calibration_expire_idle(now)) return;\n        CenterCalibration_Fail(1U, CENTER_CAL_REASON_PHASE_TIMEOUT, &s, gate_mask);\n        return;\n    }\n    if (phase == CENTER_CAL_START_STABLE) {\n        if (!g_motion.center_cal.relative_valid) {\n            CenterCalibration_Fail(2U, CENTER_CAL_REASON_RELATIVE_MISMATCH, &s, gate_mask);\n            return;\n        }\n        if (!center_feedback_ready(&s, 1U)) {\n            CenterCalibration_Fail(2U, CENTER_CAL_REASON_GATE_NOT_READY, &s, gate_mask);\n            return;\n        }\n        if (s.coherent_feedback_ms == 0U || s.coherent_feedback_ms == g_motion.center_cal.last_sample_ms) return;\n        g_motion.center_cal.last_sample_ms = s.coherent_feedback_ms;\n        if (++g_motion.center_cal.stable_samples < 3U) return;\n        PatrolRuntimePort_Enter();\n        g_motion.center_cal.phase = CENTER_CAL_READY;\n        g_motion.center_cal.deadline_ms = now + CENTER_CAL_READY_IDLE_MS;\n        PatrolRuntimePort_Exit();\n        return;\n    }\n    if (phase == CENTER_CAL_JOGGING || phase == CENTER_CAL_STOPPING) {\n        if (g_motion.bench.phase == BENCH_FAULT) {\n            CenterCalibration_Fail(2U, CENTER_CAL_REASON_BENCH_EXECUTOR_FAULT, &s, gate_mask);\n            return;\n        }\n        if (!g_motion.center_cal.relative_valid || !center_feedback_ready(&s, 0U))\n            CenterCalibration_RequestStopForFault(\n                g_motion.center_cal.relative_valid ? CENTER_CAL_REASON_GATE_NOT_READY :\n                CENTER_CAL_REASON_RELATIVE_MISMATCH, gate_mask, now);\n        if (phase == CENTER_CAL_STOPPING && g_motion.bench.phase == BENCH_IDLE) {\n            uint8_t cancelled = 0U;\n            if (g_motion.center_cal.stop_fault_pending) {\n                CenterCalibration_Fail(2U,\n                    (CenterCalibrationReason)g_motion.center_cal.stop_fault_reason, &s,\n                    g_motion.center_cal.stop_gate_mask);\n                return;\n            }\n            PatrolRuntimePort_Enter();\n            if (g_motion.center_cal.cancel_requested) {\n                memset(&g_motion.center_cal, 0, sizeof(g_motion.center_cal));\n                cancelled = 1U;\n            } else {\n                g_motion.center_cal.phase = CENTER_CAL_READY;\n                g_motion.center_cal.deadline_ms = now + CENTER_CAL_READY_IDLE_MS;\n            }\n            PatrolRuntimePort_Exit();\n            if (cancelled) {\n                RemoteService_Revoke();\n                (void)VehiclePowerOutput_Set(0U);\n            }\n        }\n        return;\n    }\n    if (phase == CENTER_CAL_COMMIT_STABLE) {\n        if (g_motion.bench.phase != BENCH_IDLE) {\n            CenterCalibration_Fail(3U, CENTER_CAL_REASON_COMMIT_BENCH_BUSY, &s, gate_mask);\n            return;\n        }\n        if ((s.steering_status_word & 0x006FU) == 0x0027U) {\n            CenterCalibration_Fail(3U, CENTER_CAL_REASON_COMMIT_STEERING_ENABLED, &s, gate_mask);\n            return;\n        }\n        if (!center_feedback_ready(&s, 1U)) {\n            CenterCalibration_Fail(3U, CENTER_CAL_REASON_GATE_NOT_READY, &s, gate_mask);\n            return;\n        }\n        if (s.coherent_feedback_ms == 0U || s.coherent_feedback_ms == g_motion.center_cal.last_sample_ms) return;\n        g_motion.center_cal.last_sample_ms = s.coherent_feedback_ms;\n        if (++g_motion.center_cal.stable_samples < 3U) return;\n        g_motion.center_cal.captured_driver_count = s.steering_position_count;\n        if (!PatrolConfig_ClearCalibration()) {\n            CenterCalibration_Fail(4U, CENTER_CAL_REASON_CONFIG_CLEAR_FAILED, &s, gate_mask);\n            return;\n        }\n        PatrolRuntimePort_Enter();\n        SteeringCoordinate_Reset(&g_motion.coordinate);\n        g_motion.center_cal.encoder_write_state = 1U;\n        g_motion.center_cal.phase = CENTER_CAL_ENCODER_WRITE;\n        g_motion.center_cal.deadline_ms = now + 2000U;\n        PatrolRuntimePort_Exit();\n        return;\n    }\n    if (phase == CENTER_CAL_ENCODER_WRITE) {\n        if (g_motion.center_cal.encoder_write_state == 3U) {\n            CenterCalibration_Fail(5U, CENTER_CAL_REASON_ENCODER_TX_FAILED, &s, gate_mask);\n            return;\n        }\n        if (g_motion.center_cal.encoder_write_state == 2U || g_motion.center_cal.encoder_write_state == 5U) {\n            PatrolRuntimePort_Enter();\n            g_motion.center_cal.phase = CENTER_CAL_ENCODER_VERIFY;\n            g_motion.center_cal.stable_samples = 0U;\n            g_motion.center_cal.last_sample_ms = s.encoder_sample_ms;\n            g_motion.center_cal.deadline_ms = now + 2000U;\n            PatrolRuntimePort_Exit();\n        }\n        return;\n    }\n    if (phase == CENTER_CAL_ENCODER_VERIFY) {\n        if (s.encoder_sample_ms == 0U || s.encoder_sample_ms == g_motion.center_cal.last_sample_ms) return;\n        g_motion.center_cal.last_sample_ms = s.encoder_sample_ms;\n        if (s.encoder_count >= VEHICLE_ABSOLUTE_SINGLE_TURN_COUNTS ||\n            (s.encoder_count > 2U && s.encoder_count < VEHICLE_ABSOLUTE_SINGLE_TURN_COUNTS - 2U)) {\n            CenterCalibration_Fail(6U, CENTER_CAL_REASON_ENCODER_VERIFY_MISMATCH, &s, gate_mask);\n            return;\n        }\n        if (++g_motion.center_cal.stable_samples < 3U) return;\n        if (!PatrolConfig_SetCalibration(g_motion.center_cal.captured_driver_count,\n                VEHICLE_ABSOLUTE_CENTER_COUNT, VEHICLE_STEERING_COUNTS_MILLI,\n                VEHICLE_ABSOLUTE_COUNTS_MILLI, VEHICLE_STEERING_DIRECTION,\n                VEHICLE_ABSOLUTE_DIRECTION, VEHICLE_STEERING_TOLERANCE_MDEG)) {\n            CenterCalibration_Fail(7U, CENTER_CAL_REASON_CONFIG_SAVE_FAILED, &s, gate_mask);\n            return;\n        }\n        RemoteService_Revoke();\n        (void)VehiclePowerOutput_Set(0U);\n        PatrolRuntimePort_Enter();\n        SteeringCoordinate_Reset(&g_motion.coordinate);\n        g_motion.center_cal.phase = CENTER_CAL_COMPLETE;\n        g_motion.center_cal.deadline_ms = now + CENTER_CAL_DONE_OBSERVE_MS;\n        PatrolRuntimePort_Exit();\n    }\n}\n\n#include "motion_internal.h"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include "app_log.h"\n#include "remote_service.h"\n#include "patrol_config.h"\n#include "patrol_can_status.h"\n#include "patrol_can_remote.h"\n#include "vehicle_power_output.h"\n#include "vehicle_steering_profile.h"\n#include "patrol_fault_stop.h"\n\nPatrolMotion g_motion;\n\n#ifndef PATROL_STEERING_EXECUTOR_ENABLED\n#define PATROL_STEERING_EXECUTOR_ENABLED 0\n#endif\n#ifndef PATROL_DRIVE_EXECUTOR_ENABLED\n#define PATROL_DRIVE_EXECUTOR_ENABLED 0\n#endif\n#ifndef PATROL_CHASSIS_ACTUATION_ENABLED\n#define PATROL_CHASSIS_ACTUATION_ENABLED 0\n#endif\n\nstatic MotionFaultRecord last_fault;\nstatic uint8_t fault_captured, fault_dirty, fault_storage;\nstatic PatrolFaultStop fault_stop;\n// 复制最近一次运动故障记录。在临界区读取固定快照，记录是否存在由返回值表示；故障记录与实时反馈是不同证据。\nuint8_t PatrolRuntime_GetFault(MotionFaultRecord* record)\n{\n    PatrolRuntimePort_Enter(); *record = last_fault; PatrolRuntimePort_Exit();\n    return record->magic == 0x4D463031U;\n}\n// 开启一个新的故障记录周期。仅重置本轮首故障捕获标志，后续首因由 CaptureFault 保存，不等同于清除驱动器故障。\nvoid PatrolRuntime_BeginFaultEpisode(void) { if (!fault_dirty) fault_captured=0; }\n// 读取运动故障记录的持久化状态码。返回当前存储标记，区分待处理、写入成功与写入失败，不能据此认定车辆已停车。\nuint8_t PatrolRuntime_FaultStorage(void) { return fault_storage; }\n// 在本轮首次故障时冻结运行上下文。记录来源、原因、门禁、双轮反馈和执行器状态并标记待存储；Flash 写入延后到断开输出且 OTA 不忙时。\nvoid PatrolRuntime_CaptureFault(uint32_t source, uint32_t reason, uint32_t gates)\n{\n    PatrolRuntimePort_Enter();\n    if (!fault_captured) {\n        uint32_t now=PatrolRuntimePort_Now(), sequence=last_fault.sequence+1U;\n        const ChassisControl* c=RemoteService_State();\n        PatrolDiagnostics* d=&g_motion.diagnostics;\n        memset(&last_fault,0,sizeof(last_fault));\n        last_fault.magic=0x4D463031U; last_fault.sequence=sequence;\n        last_fault.at_ms=now; last_fault.source=source; last_fault.reason=reason; last_fault.gates=gates;\n        last_fault.target_rpm=g_motion.drive.phase != BENCH_IDLE ? g_motion.drive.writing : c->target_rpm; last_fault.target_mdeg=c->target_steering_mdeg;\n        last_fault.left_rpm=d->left_actual_rpm; last_fault.right_rpm=d->right_actual_rpm;\n        last_fault.driver_raw=d->steering_position_count; last_fault.encoder_raw=d->encoder_count;\n        last_fault.steer_sw=d->steering_status_word; last_fault.drive_sw=d->drive_status_word;\n        last_fault.left_code=(uint32_t)d->drive_objects[0]; last_fault.right_code=(uint32_t)d->drive_objects[1];\n        last_fault.left_code_age=d->drive_code_ms[0] ? now-d->drive_code_ms[0] : UINT32_MAX;\n        last_fault.right_code_age=d->drive_code_ms[1] ? now-d->drive_code_ms[1] : UINT32_MAX;\n        last_fault.steer_age=d->steering_status_ms ? now-d->steering_status_ms : UINT32_MAX;\n        last_fault.drive_age=d->drive_status_ms ? now-d->drive_status_ms : UINT32_MAX;\n        last_fault.bench_phase=g_motion.bench.phase; last_fault.bench_step=g_motion.bench.step;\n        last_fault.bench_fault=g_motion.bench.fault; last_fault.drive_phase=g_motion.drive.phase;\n        last_fault.drive_step=g_motion.drive.step; last_fault.drive_fault=g_motion.drive.fault;\n        last_fault.last_abort=d->last_sdo_abort_code; last_fault.encoder_error=d->last_encoder_error;\n        last_fault.center_phase=g_motion.center_cal.phase;\n        fault_captured=1; fault_dirty=1; fault_storage=0;\n    }\n    PatrolRuntimePort_Exit();\n}\n\n// 每次最多提交两条安全帧，使两个节点的 shutdown 均能优先进入邮箱；不等待某个节点 ACK，不发送普通诊断或运动命令。\nstatic void dispatch_fault_stop(uint32_t now)\n{\n    if (PatrolRuntimePort_CanBusOffActive()) return;\n    for (uint8_t count = 0U; count < 2U && PatrolRuntimePort_CanTxReady(); ++count) {\n        PatrolCanFrame frame;\n        if (!PatrolFaultStop_Take(&fault_stop, now, &frame)) break;\n        if (!PatrolRuntimePort_SendCan(&frame))\n            PatrolFaultStop_TxFailed(&fault_stop, (uint8_t)(frame.id - 0x600U), now);\n    }\n}\n\n// 在控制层正式锁存前接管 CAN 停机。冻结首因、撤销授权并中止旧目标，独立发送 6040=6；此处不依赖软件 OUT1 为开。\nuint8_t PatrolRuntime_RequestFaultStop(void)\n{\n    const uint8_t nodes = PATROL_CHASSIS_ACTUATION_ENABLED ?\n        (PATROL_STEERING_EXECUTOR_ENABLED ? PATROL_FAULT_STOP_STEERING : 0U) |\n        (PATROL_DRIVE_EXECUTOR_ENABLED ? PATROL_FAULT_STOP_DRIVE : 0U) : 0U;\n    if (!nodes) return 0U;\n    PatrolRuntimePort_Enter();\n    uint32_t now = PatrolRuntimePort_Now();\n    if (!fault_stop.active && !RemoteService_State()->fault_latched) {\n        PatrolFaultStop_Init(&fault_stop);\n        PatrolRuntime_CaptureFault(1U, (uint32_t)RemoteService_State()->stop_reason, g_motion.feedback_gate_mask);\n        RemoteService_Revoke();\n        PatrolAutoCenter_Cancel(&g_motion.auto_center);\n        PatrolRuntimePort_AbortCanTx();\n        g_motion.diagnostics.pending_valid = 0U;\n        BenchDrive_Stop(&g_motion.drive, now, 1U);\n        BenchSteering_Stop(&g_motion.bench, now, 1U);\n        g_motion.drive.pending = g_motion.bench.pending = 0U;\n        g_motion.drive.cut_power = g_motion.bench.cut_power = 0U;\n        g_motion.bench_transport_stopped = 1U;\n        PatrolFaultStop_Begin(&fault_stop, nodes, now);\n        dispatch_fault_stop(now);\n    }\n    uint8_t pending = fault_stop.active;\n    PatrolRuntimePort_Exit();\n    return pending;\n}\n\n// 优先推进独立故障停机。确认关闭后再锁存和下电；600 ms 未确认或活动 Bus-Off 时先锁存/下电，仍保留仅撤使能的重试。\nstatic uint8_t service_fault_stop(void)\n{\n    PatrolRuntimePort_Enter();\n    const ChassisControl* control = RemoteService_State();\n    if (!fault_stop.active && !control->fault_pending) { PatrolRuntimePort_Exit(); return 0U; }\n    /* 配置侧重新初始化服务也不能解除尚未完成的撤使能；恢复禁止标志但不重置停机起点。 */\n    if (fault_stop.active && !control->fault_pending && !control->fault_latched)\n        RemoteService_ExecutionFault();\n    uint32_t now = PatrolRuntimePort_Now();\n    PatrolFaultStop_Tick(&fault_stop, now);\n    if (PatrolRuntimePort_CanBusOffActive()) fault_stop.latch_due = 1U;\n    dispatch_fault_stop(now);\n    if (!fault_stop.active || fault_stop.latch_due) {\n        if (control->fault_pending) {\n            APP_LOGW("FAULTSTOP", "disable mask=%u/%u confirmed=%u; latch",\n                (unsigned)fault_stop.disabled_mask, (unsigned)fault_stop.required_mask,\n                (unsigned)!fault_stop.active);\n            RemoteService_CompleteFaultStop();\n        }\n        (void)VehiclePowerOutput_Set(0U);\n        SteeringCoordinate_Reset(&g_motion.coordinate);\n        g_motion.bench.limits_aligned = 0U;\n    }\n    g_motion.drive.cut_power = g_motion.bench.cut_power = 0U;\n    PatrolRuntimePort_Exit();\n    /* 故障快照先于停机冻结；Flash 仍只允许在输出关闭及 OTA 空闲时写入。 */\n    if (fault_dirty && !VehiclePowerOutput_IsOn() && !PatrolRuntimePort_OtaBusy()) {\n        fault_storage = OTA_Info_SaveMotionFault(&last_fault) ? 1U : 2U;\n        fault_dirty = 0U;\n    }\n    return 1U;\n}\n\n// 初始化运动诊断、执行器与标定运行上下文。载入既有故障证据并建立安全默认状态，不自动恢复遥控会话或发出运动目标。\nvoid PatrolRuntime_Init(void)\n{\n    PatrolFaultStop_Init(&fault_stop);\n    PatrolDiagnostics_Init(&g_motion.diagnostics);\n    PatrolAutoCenter_Cancel(&g_motion.auto_center);\n    memset(&last_fault,0,sizeof(last_fault));\n    fault_captured=0; fault_dirty=0;\n    fault_storage=OTA_Info_LoadMotionFault(&last_fault) ? 1U : 0U;\n}\n\n// 取得带当前时间判断的运动诊断快照。在运行端口临界区内统一取样，供业务查询使用；调用者不应把旧快照当作当前运动许可。\nvoid PatrolRuntime_GetDiagnostics(PatrolDiagnosticsSnapshot* snapshot)\n{\n    if (snapshot == NULL) return;\n    PatrolRuntimePort_Enter();\n    PatrolDiagnostics_Snapshot(&g_motion.diagnostics, PatrolRuntimePort_Now(), snapshot);\n    PatrolRuntimePort_Exit();\n}\n\n// 在安全前提满足时申请清除 MCU 运动故障。复位路径检查输出、OTA、标定与执行器上下文；这是软件故障复位入口，不保证外部驱动器故障已消失。\nuint8_t PatrolRuntime_ResetFault(void)\n{\n    PatrolRuntimePort_Enter();\n    if (VehiclePowerOutput_IsOn() || PatrolRuntimePort_OtaBusy() || fault_dirty || fault_stop.active ||\n        RemoteService_State()->fault_pending ||\n        g_motion.center_cal.encoder_write_state==4U) { PatrolRuntimePort_Exit(); return 0; }\n    RemoteService_Revoke(); PatrolRuntimePort_AbortCanTx();\n    BenchSteering_Init(&g_motion.bench); BenchDrive_Init(&g_motion.drive);\n    g_motion.diagnostics.pending_valid=0; g_motion.bench_transport_stopped=0;\n    SteeringCoordinate_Reset(&g_motion.coordinate); g_motion.coordinate_reset_requested=0;\n    PatrolAutoCenter_Cancel(&g_motion.auto_center);\n    g_motion.center_cal.phase=CENTER_CAL_IDLE; g_motion.center_cal.session_id[0]=0;\n    g_motion.center_cal.encoder_write_state=0; g_motion.center_cal.fault=0;\n    RemoteService_Init(); /* No permit, enable, target or previous session survives. */\n    fault_captured=0;\n    PatrolFaultStop_Init(&fault_stop);\n    PatrolRuntimePort_Exit(); return 1;\n}\n\n// 将驱动器 CAN 反馈分发给诊断与执行器。同一帧可用于状态维护和在途响应匹配；调用方须按运行层并发约定保护共享状态。\nvoid PatrolRuntime_OnCanFrame(const PatrolCanFrame* frame, uint32_t now)\n{\n    PatrolRuntimePort_Enter();\n    /* The steering driver broadcasts its validated status/position mapping.\n     * Consume those TPDOs independently of SDO ownership and stop arbitration. */\n    uint8_t steering_tpdo = PatrolDiagnostics_OnTpdoFrame(&g_motion.diagnostics, frame, now);\n    if (PatrolFaultStop_OnFrame(&fault_stop, frame, now)) {\n        /* 原诊断事务已经取消；本流程的状态响应仍更新现场诊断时间和状态字。 */\n        PatrolDiagnostics_OnCanFrame(&g_motion.diagnostics, frame, now);\n        int32_t status; uint8_t width;\n        uint8_t node = (uint8_t)(frame->id - 0x580U);\n        if (PatrolCanopen_ParseSdoValue(frame, node, 0x6041U, 0U, &status, &width) && width == 2U) {\n            if (node == 1U) { g_motion.diagnostics.steering_status_word = (uint16_t)status; g_motion.diagnostics.steering_status_ms = now; }\n            else { g_motion.diagnostics.drive_status_word = (uint16_t)status; g_motion.diagnostics.drive_status_ms = now; }\n        }\n        PatrolRuntimePort_Exit();\n        return;\n    }\n    /* Exactly one SDO owner; executor responses never satisfy a diagnostic request. */\n    if ((frame->id == 0x701 || frame->id == 0x702) && frame->dlc == 1 && frame->data[0] == 0 &&\n        (g_motion.coordinate.valid || CenterCalibration_IsActive()))\n        g_motion.coordinate_reset_requested = 1;\n    uint8_t execution = BenchSteering_OnFrame(&g_motion.bench, frame, now) ? 1 :\n        BenchDrive_OnFrame(&g_motion.drive, frame, now) ? 2 : 0;\n    if (!execution && !steering_tpdo)\n        PatrolDiagnostics_OnCanFrame(&g_motion.diagnostics, frame, now);\n    else if (steering_tpdo)\n        g_motion.diagnostics.can_rx_count++;\n    else {\n        int32_t status; uint8_t width;\n        g_motion.diagnostics.can_rx_count++;\n        /* An executor-owned validated status upload is also fresh feedback;\n         * it must not complete a diagnostics transaction or advance its cursor. */\n        if (PatrolCanopen_ParseSdoValue(frame, execution, 0x6041, 0, &status, &width) && width == 2) {\n            if (execution == 1) {\n                g_motion.diagnostics.steering_status_word = (uint16_t)status;\n                g_motion.diagnostics.steering_status_ms = now;\n            } else {\n                g_motion.diagnostics.drive_status_word = (uint16_t)status;\n                g_motion.diagnostics.drive_status_ms = now;\n            }\n        }\n    }\n    PatrolRuntimePort_Exit();\n}\n\n// 处理下电或节点复位引起的转向坐标失效。下电清回中和限位对齐缓存，带电坐标周期丢失则停止转向并按标定阶段保留故障；调用方按运行层约定持锁。\nvoid PatrolRuntime_ApplyReset(uint32_t now)\n{\n    if (!VehiclePowerOutput_IsOn()) {\n        PatrolAutoCenter_Cancel(&g_motion.auto_center);\n        SteeringCoordinate_Reset(&g_motion.coordinate);\n        g_motion.bench.limits_aligned = 0;\n    }\n    if (g_motion.coordinate_reset_requested) {\n        /* Power-off already invalidated the coordinate above.  A late\n         * node Boot-up heartbeat during intentional de-energization\n         * must not turn an idle executor into BENCH_FAULT.  While\n         * powered, a reset of a valid coordinate remains a latched\n         * safety fault. */\n        if (VehiclePowerOutput_IsOn() && CenterCalibration_IsActive()) {\n            PatrolDiagnosticsSnapshot reset_snapshot;\n            PatrolDiagnostics_Snapshot(&g_motion.diagnostics, now, &reset_snapshot);\n            CenterCalibration_Fail(2U, CENTER_CAL_REASON_POSITION_EPOCH_RESET,\n                &reset_snapshot, CenterCalibration_GateMask(&reset_snapshot, 0U));\n        }\n        if (g_motion.coordinate.valid) BenchSteering_Stop(&g_motion.bench, now, 1);\n        SteeringCoordinate_Reset(&g_motion.coordinate);\n        g_motion.coordinate_reset_requested = 0;\n    }\n}\n\n// 处理执行器请求的切电及故障传播。将执行错误汇总到控制层并更新动力输出命令；返回处理后的时间基准，输出写入成功不代表已获得接触器物理反馈。\nuint32_t PatrolRuntime_ApplyCut(uint32_t now)\n{\n    if (g_motion.bench.cut_power || g_motion.drive.cut_power) {\n        PatrolRuntimePort_Enter();\n        now = PatrolRuntimePort_Now();\n        ChassisStopReason reason = RemoteService_State()->stop_reason;\n        PatrolRuntime_CaptureFault(1U, (uint32_t)(reason == CHASSIS_STOP_NONE ?\n            CHASSIS_STOP_EXECUTION_FAULT : reason), g_motion.feedback_gate_mask);\n        /* Capture before cross-stopping the other executor and before\n         * power-off turns healthy samples into secondary offline gates. */\n        if (CenterCalibration_IsActive()) {\n            PatrolDiagnosticsSnapshot fault_snapshot;\n            PatrolDiagnostics_Snapshot(&g_motion.diagnostics, now, &fault_snapshot);\n            CenterCalibration_CaptureFailureLocked(CENTER_CAL_REASON_BENCH_EXECUTOR_FAULT,\n                CenterCalibration_GateMask(&fault_snapshot, 0U), now, &fault_snapshot);\n            g_motion.center_cal.phase = CENTER_CAL_FAILED;\n            g_motion.center_cal.fault = 2U;\n            g_motion.center_cal.encoder_write_state = 0U;\n        }\n        BenchDrive_Stop(&g_motion.drive, now, 1);\n        BenchSteering_Stop(&g_motion.bench, now, 1);\n        g_motion.bench_fault_gate_mask = g_motion.feedback_gate_mask;\n        RemoteService_ExecutionFault();\n        if (!fault_stop.active && !RemoteService_State()->fault_pending) (void)VehiclePowerOutput_Set(0);\n        g_motion.bench.cut_power = 0; g_motion.drive.cut_power = 0;\n        PatrolRuntimePort_Exit();\n    }\n    return now;\n}\n\n// 在执行器和只读诊断之间仲裁下一个 CAN 请求。通过 owner 标识报文归属，维持运动期间事务优先级与交替读取；返回报文仅表示选中，真正发送前仍须复核授权。\nuint8_t PatrolRuntime_Take(uint32_t now, PatrolCanFrame* request, uint8_t* owner)\n{\n    uint8_t have_request = 0, bench_frame = 0, allow_retry;\n    /* While a motion write has an unknown outcome, only its bounded uploads\n     * may progress. Do not send either axis\' queued movement in the meantime. */\n    if (g_motion.bench.verify || g_motion.drive.verify) {\n        if (g_motion.diagnostics.pending_valid || g_motion.bench.pending || g_motion.drive.pending) return 0U;\n        *owner = g_motion.bench.verify ? 1U : 2U;\n        return *owner == 1U ? BenchSteering_Take(&g_motion.bench, now, request) :\n            BenchDrive_Take(&g_motion.drive, now, request);\n    }\n    /* Reserve the bus for feedback that is approaching its 250 ms expiry.\n     * Steering position updates can otherwise keep issuing PP target writes\n     * while a Node 2 status upload is still due. */\n    if (!g_motion.bench.pending && !g_motion.drive.pending &&\n        g_motion.bench.phase != BENCH_STOPPING &&\n        g_motion.drive.phase != BENCH_STOPPING &&\n        PatrolDiagnostics_HasUrgentFeedback(&g_motion.diagnostics, now)) {\n        const ChassisControl* control = RemoteService_State();\n        allow_retry = ChassisControl_SafetyReady(control, now) &&\n            VehiclePowerOutput_IsOn() && !PatrolRuntimePort_CanBusOffActive() &&\n            !PatrolRuntimePort_OtaBusy();\n        have_request = PatrolDiagnostics_TakeSdoReadUrgent(\n            &g_motion.diagnostics, now, request, allow_retry);\n        if (have_request) g_motion.bench_turn = 1U;\n        *owner = 0U;\n        /*\n         * If an existing low-priority SDO has not yet reached its bounded\n         * timeout, keep the actuator writes off the bus until the urgent\n         * read can be selected.\n         */\n        return have_request;\n    }\n    /* Alternate execution and diagnostics, never overlap pending transactions. */\n    g_motion.diagnostics.stop_priority = g_motion.bench.phase == BENCH_STOPPING;\n    if (!g_motion.diagnostics.pending_valid && !g_motion.bench.pending && !g_motion.drive.pending &&\n        (g_motion.bench_turn || BenchSteering_StopFinishReady(&g_motion.bench))) {\n        if (g_motion.drive_turn && g_motion.bench.phase != BENCH_STOPPING) {\n            have_request = BenchDrive_Take(&g_motion.drive, now, request);\n            if (have_request) { bench_frame = 2; g_motion.drive_turn = 0; }\n        }\n        if (!have_request) {\n            have_request = BenchSteering_Take(&g_motion.bench, now, request);\n            if (have_request) { bench_frame = 1; g_motion.drive_turn = 1; }\n        }\n        if (!have_request) {\n            have_request = BenchDrive_Take(&g_motion.drive, now, request);\n            if (have_request) { bench_frame = 2; g_motion.drive_turn = 0; }\n        }\n        if (have_request) g_motion.bench_turn = 0;\n    }\n    if (!have_request && !g_motion.bench.pending && !g_motion.drive.pending) {\n        const ChassisControl* control = RemoteService_State();\n        allow_retry = ChassisControl_SafetyReady(control, now) &&\n            VehiclePowerOutput_IsOn() && !PatrolRuntimePort_CanBusOffActive() &&\n            !PatrolRuntimePort_OtaBusy();\n        uint32_t before_timeouts = g_motion.diagnostics.sdo_timeout_count;\n        have_request = PatrolDiagnostics_TakeSdoRead(&g_motion.diagnostics, now, request, allow_retry);\n        if (g_motion.diagnostics.sdo_timeout_count != before_timeouts)\n            APP_LOGW("SDOREAD", "timeout entry=%u retry=%u pending=%u total=%lu",\n                (unsigned)g_motion.diagnostics.pending_entry, (unsigned)g_motion.diagnostics.pending_retry,\n                (unsigned)g_motion.diagnostics.pending_valid, (unsigned long)g_motion.diagnostics.sdo_timeout_count);\n        if (have_request) g_motion.bench_turn = 1;\n    }\n    if (!have_request && !g_motion.diagnostics.pending_valid && !g_motion.bench.pending && !g_motion.drive.pending) {\n        if (g_motion.drive_turn && g_motion.bench.phase != BENCH_STOPPING) {\n            have_request = BenchDrive_Take(&g_motion.drive, now, request);\n            if (have_request) { bench_frame = 2; g_motion.drive_turn = 0; }\n        }\n        if (!have_request) {\n            have_request = BenchSteering_Take(&g_motion.bench, now, request);\n            if (have_request) { bench_frame = 1; g_motion.drive_turn = 1; }\n        }\n        if (!have_request) {\n            have_request = BenchDrive_Take(&g_motion.drive, now, request);\n            if (have_request) { bench_frame = 2; g_motion.drive_turn = 0; }\n        }\n    }\n    *owner = bench_frame;\n    return have_request;\n}\n\n// Stop responsibility follows executor state; session ownership only grants new targets.\nenum { FEEDBACK_STOP_STEERING = 1U, FEEDBACK_STOP_DRIVE = 2U };\n\nstatic uint8_t executor_requires_stop(BenchPhase phase)\n{\n    return (phase == BENCH_PREPARING || phase == BENCH_ACTIVE || phase == BENCH_STOPPING) ? 1U : 0U;\n}\n\nstatic uint32_t feedback_due;\n\n/* >>>>> DRIVE-RECOVERY: START >>>>> */\n/* A hot MCU reset leaves the drive controllers in their previous states, which\n * can still be Operation Enabled. The normal chain then deadlocks: the steering\n * coordinate and power_ready require the steering disabled and the drive not\n * enabled, but the executors that would disable them cannot start until\n * power_ready. Break the deadlock by forcing both nodes pre-operational when\n * they are enabled, nothing owns the actuators and both executors are idle. */\n// 判断是否需要补发驱动器 shutdown 恢复命令。以会话、执行器、供电和恢复节流状态约束补发，避免持续停留在 Operation Enabled；不能取代正常停车确认。\nstatic uint8_t recovery_wanted(uint32_t now)\n{\n    const ChassisControl* c = RemoteService_State();\n    if (g_motion.bench.phase != BENCH_IDLE || g_motion.drive.phase != BENCH_IDLE) return 0U;\n    if (c->session_active || g_motion.center_cal.phase != CENTER_CAL_IDLE) return 0U;\n    if ((g_motion.diagnostics.steering_status_word & 0x6FU) == 0x27U &&\n        (uint32_t)(now - g_motion.diagnostics.steering_status_ms) <= 250U) return 1U;\n    if ((g_motion.diagnostics.drive_status_word & 0x4FU) == 7U &&\n        (uint32_t)(now - g_motion.diagnostics.drive_status_ms) <= 250U) return 1U;\n    return 0U;\n}\n/* <<<<< DRIVE-RECOVERY: END <<<<< */\n\n// 查询本地自动回中是否持有转向请求。供业务状态和任务协调使用；不把请求存在等同于回中已经完成。\nuint8_t PatrolRuntime_AutoCenterActive(void)\n{\n    uint8_t active;\n    PatrolRuntimePort_Enter(); active = g_motion.auto_center.requested; PatrolRuntimePort_Exit();\n    return active;\n}\n\n// 计算两个新鲜样本的最短时间差，兼容毫秒计数自然回绕。\nstatic uint32_t angle_sample_skew(uint32_t first, uint32_t second)\n{\n    uint32_t forward = first - second;\n    uint32_t backward = second - first;\n    return forward < backward ? forward : backward;\n}\n\n// 检查无遥控会话时本地自动回中可用条件。双角差只在启动前核对，执行中继续监督其他安全门禁。\nstatic uint8_t auto_center_safe(const ChassisControl* control, uint32_t now)\n{\n    return PATROL_CHASSIS_ACTUATION_ENABLED && PATROL_STEERING_EXECUTOR_ENABLED &&\n        !control->auto_center_inhibited &&\n        !CenterCalibration_IsActive() && g_motion.coordinate.valid && VehiclePowerOutput_IsOn() &&\n        !PatrolRuntimePort_CanBusOffActive() && !PatrolRuntimePort_OtaBusy() &&\n        ChassisControl_SafetyReady(control, now);\n}\n\n// 汇总驱动器与绝对编码器反馈并更新安全仲裁输入。同锁读取时间和诊断快照，建立运行坐标并归一化镜像右轮方向；标定相对反馈、Bus-Off 恢复观察和反馈门禁在此同步更新。\nvoid PatrolRuntime_UpdateFeedback(uint32_t now)\n{\n    PatrolDiagnosticsSnapshot snapshot;\n    ChassisFeedback feedback;\n    const PatrolRemoteConfigV5_t* cfg = PatrolConfig_Get();\n    memset(&feedback, 0, sizeof(feedback));\n    PatrolRuntimePort_Enter();\n    /* Read time and feedback under the same lock: RX can otherwise publish a\n     * timestamp newer than now and unsigned age arithmetic reports it stale. */\n    now = PatrolRuntimePort_Now();\n    PatrolDiagnostics_Snapshot(&g_motion.diagnostics, now, &snapshot);\n    PatrolRuntimePort_Exit();\n    /* Clear only the recovered CAN gate. Sessions remain revoked. */\n    PatrolRtos_ObserveCanRecovery(snapshot.coherent_feedback_ms,\n        VehiclePowerOutput_IsOn() && snapshot.steering_online && snapshot.drive_online &&\n        snapshot.steering_feedback_fresh && snapshot.drive_feedback_fresh &&\n        snapshot.encoder_online && snapshot.encoder_config_valid && !snapshot.drive_fault &&\n        labs(snapshot.left_actual_rpm) <= 20L && labs(snapshot.right_actual_rpm) <= 20L);\n    feedback.calibrated = cfg != NULL && cfg->calibrated && PatrolConfig_CalibrationCompatible();\n    feedback.encoder_profile_ready = PatrolConfig_SingleTurnProfileReady();\n    feedback.steering_online = snapshot.steering_online;\n    feedback.drive_online = snapshot.drive_online;\n    feedback.can_bus_off = PatrolRuntimePort_CanBusOff();\n    feedback.drive_fault = snapshot.drive_fault;\n    feedback.ota_busy = PatrolRuntimePort_OtaBusy();\n    /* Readiness uses driver and encoder evidence, never a nonexistent contactor input. */\n    g_motion.feedback_gate_mask = (!snapshot.steering_feedback_fresh ? 1U : 0U) |\n        (!snapshot.drive_feedback_fresh ? 2U : 0U) | (!snapshot.encoder_online ? 4U : 0U) |\n        (!snapshot.steering_status_fresh ? 8U : 0U) | (!snapshot.drive_status_fresh ? 16U : 0U) |\n        (!snapshot.encoder_config_valid ? 32U : 0U) |\n        ((snapshot.drive_status_word & 4U) != 0 ? 64U : 0U) |\n        ((labs(snapshot.left_actual_rpm) > 20 || labs(snapshot.right_actual_rpm) > 20) ? 128U : 0U) |\n        (!VehiclePowerOutput_IsOn() ? 256U : 0U);\n    /* An executing drive session may pass moving/Operation Enabled gates\n     * while its bounded stop sequence is in progress. */\n    if (g_motion.drive.phase != BENCH_IDLE && g_motion.drive.phase != BENCH_FAULT)\n        g_motion.feedback_gate_mask &= (uint16_t)~(64U | 128U);\n    feedback.encoder_range_valid = SteeringAngle_AbsoluteWithinLimit(\n        snapshot.encoder_count, cfg->absolute_center_count,\n        cfg->absolute_counts_per_degree_milli, cfg->absolute_direction,\n        VEHICLE_STEERING_TRIP_MDEG, &feedback.encoder_actual_mdeg);\n    if (PATROL_STEERING_EXECUTOR_ENABLED) {\n        uint8_t was_valid = g_motion.coordinate.valid;\n        if (!VehiclePowerOutput_IsOn() || CenterCalibration_IsActive()) SteeringCoordinate_Reset(&g_motion.coordinate);\n        else if (g_motion.coordinate.valid && SteeringCoordinate_EpochLost(\n            g_motion.feedback_gate_mask, snapshot.steering_online,\n            cfg->steering_center_count == g_motion.coordinate_calibration_center &&\n            cfg->absolute_center_count == g_motion.coordinate_absolute_center)) {\n            /* A lost position epoch requires power-off, never a live re-zero. */\n            PatrolRuntimePort_Enter();\n            BenchSteering_Stop(&g_motion.bench, now, 1);\n            SteeringCoordinate_Reset(&g_motion.coordinate);\n            PatrolRuntimePort_Exit();\n        } else {\n            SteeringCoordinate_Observe(&g_motion.coordinate,\n                g_motion.feedback_gate_mask == 0 && feedback.calibrated && feedback.encoder_range_valid &&\n                snapshot.steering_online && snapshot.drive_online &&\n                !snapshot.drive_fault && !feedback.can_bus_off && !feedback.ota_busy &&\n                (snapshot.steering_status_word & 0x6FU) != 0x27U,\n                snapshot.steering_position_count, snapshot.encoder_count, cfg->absolute_center_count,\n                snapshot.coherent_feedback_ms, now);\n        }\n        if (!was_valid && g_motion.coordinate.valid) {\n            g_motion.coordinate_calibration_center = cfg->steering_center_count;\n            g_motion.coordinate_absolute_center = cfg->absolute_center_count;\n        }\n        if (!g_motion.coordinate.valid) g_motion.feedback_gate_mask |= 512U;\n    }\n    feedback.power_ready = PATROL_CHASSIS_ACTUATION_ENABLED &&\n        PATROL_STEERING_EXECUTOR_ENABLED && g_motion.feedback_gate_mask == 0;\n    feedback.left_actual_rpm = snapshot.left_actual_rpm > 32767 ? 32767 :\n        (snapshot.left_actual_rpm < -32768 ? -32768 : (int16_t)snapshot.left_actual_rpm);\n    /* Normalize mirror-mounted right-wheel feedback to vehicle coordinates.\n     * Raw controller sign remains available in get_can_diag. */\n    feedback.right_actual_rpm = snapshot.right_actual_rpm > 32768 ? -32768 :\n        (snapshot.right_actual_rpm < -32767 ? 32767 : (int16_t)-snapshot.right_actual_rpm);\n    feedback.angle_pair_valid = (uint8_t)(snapshot.steering_feedback_fresh && snapshot.encoder_online &&\n        angle_sample_skew(snapshot.steering_position_ms, snapshot.encoder_sample_ms) <=\n            CHASSIS_STEERING_PAIR_SKEW_MS);\n    if (feedback.calibrated)\n    {\n        feedback.steering_actual_mdeg = SteeringAngle_FromControllerCount(\n            snapshot.steering_position_count,\n            PATROL_STEERING_EXECUTOR_ENABLED && g_motion.coordinate.valid ?\n                g_motion.coordinate.runtime_center : cfg->steering_center_count,\n            cfg->steering_counts_per_degree_milli, cfg->steering_direction);\n        if (!feedback.encoder_range_valid)\n            feedback.encoder_actual_mdeg = SteeringAngle_FromAbsoluteCount(\n                snapshot.encoder_count, cfg->absolute_center_count,\n                cfg->absolute_counts_per_degree_milli, cfg->absolute_direction);\n    }\n    feedback.feedback_ms = snapshot.coherent_feedback_ms != 0U ?\n        snapshot.coherent_feedback_ms : now - (CHASSIS_FEEDBACK_TIMEOUT_MS + 1U);\n    PatrolRuntimePort_Enter();\n    CenterCalibration_UpdateRelative(&snapshot);\n    RemoteService_UpdateFeedback(&feedback);\n    if (g_motion.center_cal.phase == CENTER_CAL_JOGGING && g_motion.bench.phase == BENCH_ACTIVE &&\n        snapshot.coherent_feedback_ms != 0U &&\n        snapshot.coherent_feedback_ms != g_motion.center_cal.last_sample_ms &&\n        g_motion.center_cal.relative_valid &&\n        labs(g_motion.center_cal.driver_relative_mdeg - g_motion.center_cal.target_mdeg) <= 200L &&\n        labs(g_motion.center_cal.encoder_relative_mdeg - g_motion.center_cal.target_mdeg) <= 200L) {\n        g_motion.center_cal.last_sample_ms = snapshot.coherent_feedback_ms;\n        if (++g_motion.center_cal.stable_samples >= 3U) {\n            BenchSteering_Stop(&g_motion.bench, now, 0U);\n            g_motion.center_cal.phase = CENTER_CAL_STOPPING;\n            g_motion.center_cal.deadline_ms = now + 2000U;\n        }\n    }\n    PatrolRuntimePort_Exit();\n    feedback_due = now + 20U;\n}\n\n// 执行一次运动运行层的非阻塞调度。仲裁遥控、标定和回中，推进双执行器并处理切电、故障存储与 CAN 请求；发送前再次检查会话和租约，防止选帧后授权被撤销。\nvoid PatrolRuntime_Tick(void)\n{\n    PatrolCanFrame request;\n    uint8_t have_request = 0U;\n    uint32_t now;\n    uint8_t bench_frame = 0U;\n    if (service_fault_stop()) return;\n    PatrolRuntimePort_Enter();\n    now = PatrolRuntimePort_Now();\n    {\n        const ChassisControl* c = RemoteService_State();\n        const PatrolRemoteConfigV5_t* cfg = PatrolConfig_Get();\n        uint8_t controlled_feedback_stop;\n        PatrolRuntime_ApplyReset(now);\n        uint8_t normal_safe = g_motion.coordinate.valid && VehiclePowerOutput_IsOn() &&\n            !PatrolRuntimePort_CanBusOffActive() && ChassisControl_SafetyReady(c, now);\n        uint8_t remote_requested = c->session_active && c->enable_request &&\n            (int32_t)(now - c->lease_deadline_ms) < 0;\n        /*\n         * A single delayed status upload is a transport-scheduling event, not\n         * proof that the drive actuator rejected a write. Stop through the\n         * normal bounded zero/disable path and let a genuine stop failure\n         * decide whether to latch. Stop responsibility follows executor state,\n         * not session ownership: an explicit stop releases the session before\n         * either executor has necessarily entered STOPPING. Node, bus and\n         * drive faults retain the immediate fault path below.\n         */\n        uint8_t transient_feedback = (uint8_t)(\n            (g_motion.feedback_gate_mask & (1U | 2U | 8U | 16U)) != 0U);\n        uint8_t explicit_stop = (uint8_t)(\n            c->stop_reason == CHASSIS_STOP_EXPLICIT);\n        uint8_t feedback_stop_transport_ready = (uint8_t)(\n            !CenterCalibration_IsActive() && VehiclePowerOutput_IsOn() &&\n            !c->feedback.can_bus_off && !PatrolRuntimePort_CanBusOffActive() &&\n            c->feedback.steering_online && c->feedback.drive_online &&\n            !c->feedback.drive_fault);\n        if (!executor_requires_stop(g_motion.bench.phase))\n            g_motion.feedback_stop_mask &= (uint8_t)~FEEDBACK_STOP_STEERING;\n        if (!executor_requires_stop(g_motion.drive.phase))\n            g_motion.feedback_stop_mask &= (uint8_t)~FEEDBACK_STOP_DRIVE;\n        if (CenterCalibration_IsActive())\n            g_motion.feedback_stop_mask = 0U;\n        else if ((transient_feedback || explicit_stop) && feedback_stop_transport_ready) {\n            if (executor_requires_stop(g_motion.bench.phase))\n                g_motion.feedback_stop_mask |= FEEDBACK_STOP_STEERING;\n            if (executor_requires_stop(g_motion.drive.phase))\n                g_motion.feedback_stop_mask |= FEEDBACK_STOP_DRIVE;\n        }\n        controlled_feedback_stop = (uint8_t)(\n            !c->fault_latched && !c->fault_pending &&\n            g_motion.feedback_stop_mask != 0U &&\n            feedback_stop_transport_ready);\n        if (controlled_feedback_stop) remote_requested = 0U;\n        uint8_t center_requested = g_motion.center_cal.phase == CENTER_CAL_JOGGING;\n        uint8_t center_executor_active = center_requested ||\n            g_motion.center_cal.phase == CENTER_CAL_STOPPING;\n        uint8_t center_safe = VehiclePowerOutput_IsOn() && !PatrolRuntimePort_CanBusOffActive() &&\n            ChassisControl_RuntimeSafetyReason(c, now) == CHASSIS_STOP_NONE &&\n            (g_motion.feedback_gate_mask & (uint16_t)~512U) == 0U && g_motion.center_cal.relative_valid &&\n            llabs((int64_t)g_motion.center_cal.driver_relative_mdeg -\n                  g_motion.center_cal.encoder_relative_mdeg) <= VEHICLE_STEERING_TOLERANCE_MDEG;\n        uint8_t stop_transport_safe = VehiclePowerOutput_IsOn() &&\n            !PatrolRuntimePort_CanBusOffActive() && !PatrolRuntimePort_OtaBusy();\n        if (center_requested && !center_safe && stop_transport_safe) {\n            CenterCalibration_RequestStopForFault(\n                g_motion.center_cal.relative_valid ? CENTER_CAL_REASON_GATE_NOT_READY :\n                CENTER_CAL_REASON_RELATIVE_MISMATCH, g_motion.feedback_gate_mask, now);\n            center_requested = 0U;\n            center_executor_active = 1U;\n        }\n        /* STOPPING still belongs to the commissioning executor.  Falling\n         * back to normal_safe here rejects an intentionally uncalibrated\n         * vehicle while the executor is sending its bounded stop sequence,\n         * which turns a successful jog into BENCH_FAULT and cuts power. */\n        uint8_t safe = center_executor_active ? center_safe : normal_safe;\n        uint8_t local_safe = auto_center_safe(c, now);\n        uint8_t local_moving = 0U;\n        if (remote_requested || CenterCalibration_IsActive() || PatrolCanRemote_CalibrationPrepareActive())\n            PatrolAutoCenter_Cancel(&g_motion.auto_center);\n        else {\n            /* A lost lease revokes remote targets. Local centering owns only\n             * the steering axis and first waits for the drive\'s verified\n             * zero-speed/disable sequence to finish. SAFETY_STOP stays parked. */\n            if (!g_motion.auto_center.requested && !g_motion.auto_center.failed && local_safe &&\n                (labs(c->feedback.steering_actual_mdeg) > PATROL_AUTO_CENTER_TOLERANCE_MDEG ||\n                 labs(c->feedback.encoder_actual_mdeg) > PATROL_AUTO_CENTER_TOLERANCE_MDEG))\n            {\n                /* Wait for comparable samples before starting. A normal remote\n                 * target never passes through this centering-only check. */\n                if (c->feedback.angle_pair_valid &&\n                    llabs((int64_t)c->feedback.steering_actual_mdeg -\n                          c->feedback.encoder_actual_mdeg) > VEHICLE_STEERING_TOLERANCE_MDEG) {\n                    RemoteService_SafetyFault(CHASSIS_STOP_ANGLE_MISMATCH);\n                    normal_safe = safe = local_safe = 0U;\n                } else if (c->feedback.angle_pair_valid) {\n                    PatrolAutoCenter_Request(&g_motion.auto_center, now, c->feedback.steering_actual_mdeg);\n                }\n            }\n            local_moving = PatrolAutoCenter_Tick(&g_motion.auto_center, now, local_safe,\n                g_motion.drive.phase == BENCH_IDLE, &c->feedback);\n            if (g_motion.auto_center.failed) {\n                RemoteService_ExecutionFault();\n                BenchSteering_Stop(&g_motion.bench, now, 1U);\n            }\n        }\n        uint8_t local_requested = g_motion.auto_center.requested && local_safe;\n        uint8_t requested = remote_requested || center_requested || local_requested;\n        uint8_t executor_safe = (uint8_t)(safe || controlled_feedback_stop);\n        uint8_t executor_requested = (uint8_t)(requested && !controlled_feedback_stop);\n        int32_t requested_angle = center_requested ? g_motion.center_cal.target_mdeg :\n            local_requested ? (local_moving ? 0 : g_motion.auto_center.hold_mdeg) : c->target_steering_mdeg;\n        if (PATROL_CHASSIS_ACTUATION_ENABLED && PATROL_STEERING_EXECUTOR_ENABLED &&\n            requested && safe && (!local_requested || local_moving) && g_motion.bench.phase == BENCH_IDLE) {\n            if (center_requested)\n                BenchSteering_StartCommissioning(&g_motion.bench, g_motion.diagnostics.steering_position_count,\n                    g_motion.center_cal.start_driver_count, VEHICLE_CENTER_COMMISSIONING_LIMIT_MDEG, now);\n            else\n                BenchSteering_Start(&g_motion.bench, g_motion.diagnostics.steering_position_count,\n                    g_motion.coordinate.runtime_center, cfg->steering_center_count,\n                    CHASSIS_MAX_STEERING_MDEG, now);\n        }\n        safe = safe && !c->fault_latched;\n        uint8_t drive_requested = executor_requested && remote_requested && !c->drive_brake;\n        if (PATROL_CHASSIS_ACTUATION_ENABLED && PATROL_DRIVE_EXECUTOR_ENABLED && drive_requested && executor_safe &&\n            g_motion.bench.phase == BENCH_ACTIVE && g_motion.drive.phase == BENCH_IDLE)\n            BenchDrive_Start(&g_motion.drive, now);\n        uint8_t drive_was_verifying = g_motion.drive.verify;\n        uint8_t steer_was_verifying = g_motion.bench.verify;\n        BenchDrive_Tick(&g_motion.drive, now, drive_requested, executor_safe,\n            c->target_rpm, g_motion.diagnostics.left_actual_rpm, g_motion.diagnostics.right_actual_rpm,\n            g_motion.diagnostics.left_rpm_ms, g_motion.diagnostics.right_rpm_ms);\n        BenchSteering_Tick(&g_motion.bench, now,\n            executor_requested && g_motion.drive.phase != BENCH_FAULT,\n            center_executor_active && g_motion.center_cal.phase == CENTER_CAL_STOPPING ?\n                stop_transport_safe : executor_safe,\n            requested_angle, c->feedback.steering_actual_mdeg);\n        if (!drive_was_verifying && g_motion.drive.verify == 1U)\n            APP_LOGW("ACKVERIFY", "drive step=%u: lost write ACK; uploads only, limit=%u ms",\n                (unsigned)g_motion.drive.step, (unsigned)BENCH_WRITE_VERIFY_MS);\n        if (!steer_was_verifying && g_motion.bench.verify == 1U)\n            APP_LOGW("ACKVERIFY", "steer step=%u: lost write ACK; uploads only, limit=%u ms",\n                (unsigned)g_motion.bench.step, (unsigned)BENCH_WRITE_VERIFY_MS);\n        g_motion.diagnostics.motion_priority = CenterCalibration_IsActive() ||\n            (g_motion.bench.phase != BENCH_IDLE && g_motion.bench.phase != BENCH_FAULT) ||\n            (g_motion.drive.phase != BENCH_IDLE && g_motion.drive.phase != BENCH_FAULT);\n        if (g_motion.bench.phase == BENCH_STOPPING || g_motion.bench.phase == BENCH_FAULT) {\n            if (!CenterCalibration_IsActive() &&\n                (!remote_requested || !safe || g_motion.bench.phase == BENCH_FAULT)) RemoteService_Revoke();\n            if (!g_motion.bench_transport_stopped) {\n                g_motion.diagnostics.pending_valid = 0;\n                PatrolRuntimePort_AbortCanTx();\n                g_motion.bench_transport_stopped = 1;\n                /* Send shutdown first, then alternate confirmation and safety reads. */\n                g_motion.bench_turn = 1;\n            }\n        } else g_motion.bench_transport_stopped = 0;\n    }\n    PatrolRuntimePort_Exit();\n    now = PatrolRuntime_ApplyCut(now);\n    if (service_fault_stop()) return;\n    /* Never write flash while powered or inside the safety critical section. */\n    if (fault_dirty && !VehiclePowerOutput_IsOn() && !PatrolRuntimePort_OtaBusy()) {\n        fault_storage=OTA_Info_SaveMotionFault(&last_fault) ? 1U : 2U;\n        fault_dirty=0;\n    }\n    /* >>>>> DRIVE-RECOVERY: START >>>>> */\n    if (VehiclePowerOutput_IsOn() && !PatrolRuntimePort_CanBusOffActive() &&\n        PatrolRuntimePort_CanTxReady())\n    {\n        PatrolRuntimePort_Enter();\n        if (recovery_wanted(now)) {\n            PatrolCanFrame rec;\n            uint8_t ok1, ok2;\n            /* The drives ignore NMT pre-operational while in Operation Enabled;\n             * the CiA402 shutdown controlword is what actually releases them. */\n            rec = PatrolCanopen_SdoWrite16(PATROL_CANOPEN_STEERING_NODE, 0x6040U, 0U, 6U);\n            ok1 = PatrolRuntimePort_SendCan(&rec);\n            rec = PatrolCanopen_SdoWrite16(PATROL_CANOPEN_DRIVE_NODE, 0x6040U, 0U, 6U);\n            ok2 = PatrolRuntimePort_SendCan(&rec);\n            APP_LOGI("RECOVER", "shutdown steer=%u drive=%u", (unsigned)ok1, (unsigned)ok2);\n        }\n        PatrolRuntimePort_Exit();\n    }\n    /* <<<<< DRIVE-RECOVERY: END <<<<< */\n    if (VehiclePowerOutput_IsOn() && !PatrolRuntimePort_CanBusOffActive() &&\n        PatrolRuntimePort_CanTxReady())\n    {\n        PatrolRuntimePort_Enter();\n        have_request = PatrolRuntime_Take(now, &request, &bench_frame);\n        PatrolRuntimePort_Exit();\n    }\n    if (have_request)\n    {\n        PatrolRuntimePort_Enter();\n        /* 高优先级安全任务可能在普通帧选出后启动故障停机；任何旧 owner 的帧都必须丢弃。 */\n        if (fault_stop.active || RemoteService_State()->fault_pending) have_request = 0U;\n        /* A traction inhibit can arrive after frame selection. Discard an old drive\n         * command and start its bounded zero/disable sequence, without touching\n         * the steering executor or the shared session. */\n        if (bench_frame == 2 && RemoteService_State()->drive_brake &&\n            g_motion.drive.phase != BENCH_STOPPING && g_motion.drive.phase != BENCH_IDLE) {\n            BenchDrive_Stop(&g_motion.drive, PatrolRuntimePort_Now(), 0U);\n            have_request = 0U;\n        }\n        /* A higher priority safety tick may have revoked the selected command. */\n        if (have_request && bench_frame && g_motion.center_cal.phase != CENTER_CAL_JOGGING &&\n            g_motion.center_cal.phase != CENTER_CAL_STOPPING && (bench_frame == 1 ?\n            (g_motion.bench.phase != BENCH_STOPPING && g_motion.bench.phase != BENCH_IDLE) :\n            (g_motion.drive.phase != BENCH_STOPPING && g_motion.drive.phase != BENCH_IDLE)) &&\n             (!RemoteService_State()->session_active || !RemoteService_State()->enable_request ||\n              (int32_t)(PatrolRuntimePort_Now() - RemoteService_State()->lease_deadline_ms) >= 0) &&\n             !(bench_frame == 1 && g_motion.auto_center.requested &&\n               auto_center_safe(RemoteService_State(), PatrolRuntimePort_Now()))) {\n            BenchSteering_Stop(&g_motion.bench, PatrolRuntimePort_Now(), 0);\n            BenchDrive_Stop(&g_motion.drive, PatrolRuntimePort_Now(), 0);\n            have_request = 0;\n        }\n        /* Each compiled executor is restricted to its own node. */\n        if (have_request && ((bench_frame == 1 && PATROL_STEERING_EXECUTOR_ENABLED &&\n                (request.id == 0x601U || (request.id == 0 && request.data[1] == 1))) ||\n              (bench_frame == 2 && PATROL_DRIVE_EXECUTOR_ENABLED &&\n                (request.id == 0x602U || (request.id == 0 && request.data[1] == 2))) ||\n             (!bench_frame && (request.id == 0x601U || request.id == 0x602U) && request.data[0] == 0x40U)) &&\n            !PatrolRuntimePort_SendCan(&request))\n        {\n            PatrolRuntimePort_Enter();\n            if (bench_frame == 2) BenchDrive_TxFailed(&g_motion.drive);\n            else if (bench_frame == 1) BenchSteering_TxFailed(&g_motion.bench);\n            else PatrolDiagnostics_OnSdoTxError(&g_motion.diagnostics, now);\n            PatrolRuntimePort_Exit();\n        }\n        PatrolRuntimePort_Exit();\n    }\n    if ((int32_t)(now - feedback_due) >= 0) {\n        PatrolRuntime_UpdateFeedback(now);\n    }\n}\n\n// 为编码器任务取得快照并领取一次配置写入请求。领取动作在临界区内将请求改为进行中，避免重复写入；返回非零表示本周期应执行编码器写事务。\nuint8_t PatrolRuntime_BeginEncoderCycle(PatrolDiagnosticsSnapshot* snapshot)\n{\n    uint8_t write_center = 0;\n    PatrolRuntimePort_Enter();\n    PatrolDiagnostics_Snapshot(&g_motion.diagnostics, PatrolRuntimePort_Now(), snapshot);\n    if (g_motion.center_cal.encoder_write_state == 1U) {\n        g_motion.center_cal.encoder_write_state = 4U;\n        write_center = 1U;\n    }\n    PatrolRuntimePort_Exit();\n    return write_center;\n}\n\n// 发布编码器配置写入或验证的结果状态。在临界区更新标定写状态，后续标定流程据此决定提交或故障，不在此写 Flash。\nvoid PatrolRuntime_EncoderWriteCompleted(uint8_t state)\n{\n    PatrolRuntimePort_Enter();\n    g_motion.center_cal.encoder_write_state = state;\n    PatrolRuntimePort_Exit();\n}\n\n// 接收编码器寄存器配置并更新诊断。调用方须保护诊断共享上下文；仅登记本次读到的参数，不自行改变规格或标定。\nvoid PatrolRuntime_OnEncoderConfig(const uint16_t* registers, uint32_t now)\n{\n    PatrolDiagnostics_OnEncoderConfig(&g_motion.diagnostics, registers, now);\n}\n\n// 接收绝对编码器计数及其采样时间。调用方持有运行层所需保护，计数随后参与角度、量程和新鲜度判断。\nvoid PatrolRuntime_OnEncoderCount(uint32_t count, uint32_t now)\n{\n    PatrolDiagnostics_OnEncoderCount(&g_motion.diagnostics, count, now);\n}\n\n// 登记编码器通信或格式错误。错误分类交由诊断层累计和暴露，不用无效数据刷新成功采样时间。\nvoid PatrolRuntime_OnEncoderError(PatrolEncoderError error)\n{\n    PatrolDiagnostics_OnEncoderError(&g_motion.diagnostics, error);\n}\n'

