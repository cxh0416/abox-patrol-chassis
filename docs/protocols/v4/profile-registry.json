{
  "schemaVersion": 1,
  "protocolVersion": "4.0",
  "profile": {
    "name": "vehicle_chassis",
    "supportedMajors": [
      1
    ],
    "currentVersion": "1.0",
    "contract": "https://github.com/cxh0416/abox-patrol-vehicle-chassis-firmware/blob/main/docs/protocols/A-BOX巡防车底盘业务协议-V4.0.md",
    "commands": [
      {
        "name": "power_on",
        "applicableProfiles": [
          "vehicle_chassis"
        ],
        "introducedVersion": "1.0",
        "semanticDescription": "Request profile-defined power outputs on; success and safety rules remain profile-specific.",
        "classification": "DISCRETE_ACTION",
        "operationMatcher": {
          "field": "data.command",
          "equals": "power_on"
        }
      },
      {
        "name": "power_off",
        "applicableProfiles": [
          "vehicle_chassis"
        ],
        "introducedVersion": "1.0",
        "semanticDescription": "Request profile-defined power outputs off; success and safety rules remain profile-specific.",
        "classification": "SAFETY_STOP",
        "operationMatcher": {
          "field": "data.command",
          "equals": "power_off"
        }
      },
      {
        "name": "chassis_control",
        "applicableProfiles": [
          "vehicle_chassis"
        ],
        "introducedVersion": "1.0",
        "semanticDescription": "Acquire, renew, or safely stop the leased chassis motion session.",
        "classification": "CONTINUOUS_SESSION",
        "operationMatcher": {
          "field": "data.command",
          "equals": "chassis_control"
        }
      }
    ],
    "reports": [
      {
        "name": "chassis_status",
        "ownerProfile": "vehicle_chassis",
        "introducedVersion": "1.0",
        "semanticDescription": "Complete public chassis target, measured feedback, safety, power, and fault state.",
        "reportType": "state",
        "operationMatcher": {
          "field": "data.reportName",
          "equals": "chassis_status"
        }
      }
    ]
  }
}
